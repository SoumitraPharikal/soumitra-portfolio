---
// src/components/Thumbnail.astro
import fs from 'node:fs';
import path from 'node:path';
import { thumbnailManifest } from '../data/thumbnails';

interface Props {
  id: string;
  class?: string;
  aspectRatio?: string;
}

const { id, class: className = '', aspectRatio = '16 / 9' } = Astro.props;

const item = thumbnailManifest[id];

if (!item) {
  throw new Error(`[Thumbnail] Unknown thumbnail id: "${id}". Must be defined in src/data/thumbnails.ts`);
}

// Custom drop-in mapping for project thumbnails
const customProjectThumbnails: Record<string, string> = {
  'ic-1369-photometry-pipeline': '/thumbnails/projects/ic1369.png',
  'monograph-01-ic1369': '/thumbnails/projects/ic1369.png',
  'astra-rust-toolkit': '/thumbnails/projects/astra.png',
  'ct-imaging-tumour-detection': '/thumbnails/projects/radon-ct.png',
  'monograph-02-radon-ct': '/thumbnails/projects/radon-ct.png',
  'zernike-wavefront-analyzer': '/thumbnails/projects/zernike.png',
  'quantum-uncertainty-wavepackets': '/thumbnails/projects/quantum-fft.png',
  'monte-carlo-stochastic-decay': '/thumbnails/projects/monte-carlo.png',
};

const customThumbPath = customProjectThumbnails[id];

// Check on-disk existence in public/ folder
const publicDir = path.resolve('public');
let resolvedSrc = item.src;
let fileExists = false;

if (customThumbPath && fs.existsSync(path.join(publicDir, customThumbPath.slice(1)))) {
  resolvedSrc = customThumbPath;
  fileExists = true;
} else {
  const relPath = item.src.startsWith('/') ? item.src.slice(1) : item.src;
  const absPath = path.join(publicDir, relPath);
  fileExists = fs.existsSync(absPath);
}
---

<div class:list={['thumbnail-wrapper', className]} style={`aspect-ratio: ${aspectRatio};`}>
  {fileExists ? (
    <picture class="thumbnail-picture">
      <img
        src={resolvedSrc}
        alt={item.alt}
        width={item.width}
        height={item.height}
        loading="lazy"
        decoding="async"
        class="thumbnail-img"
        onerror="this.style.display='none'; if(this.parentElement && this.parentElement.nextElementSibling) this.parentElement.nextElementSibling.style.display='flex';"
      />
    </picture>
  ) : (
    <div class="thumbnail-svg-fallback" title={item.alt}>
      <Fragment set:html={item.fallbackSvg} />
    </div>
  )}
</div>

<style>
  .thumbnail-wrapper {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--bg-surface-sunken);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumbnail-picture {
    width: 100%;
    height: 100%;
    display: block;
  }

  .thumbnail-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .thumbnail-wrapper:hover .thumbnail-img {
    transform: scale(1.03);
  }

  .thumbnail-svg-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.thumbnail-svg-fallback svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
