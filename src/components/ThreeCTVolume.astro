---
// src/components/ThreeCTVolume.astro
// Procedural 3D CT Volume & Shepp-Logan Phantom with Interactive Slicing Plane
// Full 3D mouse rotation; Z-axis slice scrubber; lazy loaded Three.js
---

<div class="ct-volume-widget hairline-box spotlight-card corner-crosshair" id="ct-volume-container">
  <div class="ct-masthead hairline-bottom">
    <div class="ct-masthead-left">
      <span class="pulse-dot" aria-hidden="true"></span>
      <span class="mono text-signal">3D COMPUTED TOMOGRAPHY VOLUME RECONSTRUCTION</span>
    </div>
    <div class="ct-masthead-right mono text-secondary">
      <span id="ct-slice-readout">Z-SLICE: 0.00 mm · 256³ VOXELS</span>
    </div>
  </div>

  <div class="ct-canvas-wrapper" id="ct-canvas-container">
    <canvas id="three-ct-canvas" class="ct-canvas"></canvas>

    <!-- Technical SVG Fallback when WebGL is unavailable or prefers-reduced-motion -->
    <div class="ct-fallback" id="ct-fallback">
      <svg viewBox="0 0 400 300" class="fallback-svg" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Computed Tomography Axial Slice Schematic">
        <!-- Outer Skull Ring -->
        <ellipse cx="200" cy="150" rx="90" ry="110" stroke="var(--accent-primary)" stroke-width="2" fill="var(--bg-surface-elevated)" opacity="0.6" />
        <!-- Brain Tissue -->
        <ellipse cx="200" cy="150" rx="80" ry="98" stroke="var(--border-strong)" stroke-width="1.5" fill="var(--bg-surface)" />
        <!-- Ventricles -->
        <ellipse cx="185" cy="140" rx="12" ry="30" stroke="var(--text-tertiary)" stroke-width="1.2" fill="var(--bg-surface-sunken)" />
        <ellipse cx="215" cy="140" rx="12" ry="30" stroke="var(--text-tertiary)" stroke-width="1.2" fill="var(--bg-surface-sunken)" />
        <!-- High-attenuation Tumour Neoplasm -->
        <circle cx="170" cy="180" r="14" stroke="var(--accent-gold)" stroke-width="2" fill="var(--accent-gold)" opacity="0.8" />
        <circle cx="170" cy="180" r="22" stroke="var(--accent-gold)" stroke-width="1" stroke-dasharray="3 3" />
        <!-- Crosshairs -->
        <line x1="200" y1="20" x2="200" y2="280" stroke="var(--border-subtle)" stroke-width="1" stroke-dasharray="4 4" />
        <line x1="60" y1="150" x2="340" y2="150" stroke="var(--border-subtle)" stroke-width="1" stroke-dasharray="4 4" />
        <!-- Labels -->
        <text x="24" y="32" class="svg-mono" fill="var(--text-secondary)">SHEPP-LOGAN PHANTOM FOV</text>
        <text x="24" y="48" class="svg-mono" fill="var(--accent-gold)">NEOPLASM ATTENUATION: μ = 1.84 cm⁻¹</text>
        <text x="24" y="64" class="svg-mono" fill="var(--accent-primary)">RAM-LAK FILTERED BACKPROJECTION</text>
      </svg>
    </div>

    <!-- Slice Scrubber Bar -->
    <div class="ct-slice-control hairline-top mono">
      <label for="ct-slice-slider" class="ct-slider-label">AXIAL PLANE Z:</label>
      <input
        type="range"
        id="ct-slice-slider"
        min="-45"
        max="45"
        step="0.5"
        value="0"
        class="ct-slider"
        aria-label="CT Axial Slice Plane Depth"
      />
      <span class="ct-hint">DRAG TO ORBIT 3D VOLUME</span>
    </div>
  </div>
</div>

<style>
  .ct-volume-widget {
    background: var(--bg-surface);
    border-radius: var(--radius-card);
    overflow: hidden;
    margin: var(--space-4) 0;
    border: 1px solid var(--border-subtle);
  }

  .ct-masthead {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px var(--space-4);
    background: var(--bg-surface-elevated);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .ct-masthead-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ct-canvas-wrapper {
    position: relative;
    width: 100%;
    height: 340px;
    background: var(--bg-primary);
    cursor: grab;
    overflow: hidden;
  }

  .ct-canvas-wrapper:active {
    cursor: grabbing;
  }

  .ct-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ct-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: var(--bg-surface-sunken);
  }

  .fallback-svg {
    width: 85%;
    max-height: 85%;
  }

  .svg-mono {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
  }

  .ct-slice-control {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 8px var(--space-4);
    background: var(--bg-surface-elevated);
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.75rem;
  }

  .ct-slider-label {
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .ct-slider {
    flex: 1;
    height: 4px;
    background: var(--border-subtle);
    border-radius: 2px;
    appearance: none;
    -webkit-appearance: none;
    outline: none;
    cursor: pointer;
  }

  .ct-slider::-webkit-slider-thumb {
    appearance: none;
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent-primary);
    cursor: pointer;
  }

  .ct-hint {
    color: var(--text-tertiary);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  [data-theme="light"] .ct-volume-widget {
    background: #FAF8F3;
    border: 1px solid rgba(14, 26, 43, 0.14);
  }

  [data-theme="light"] .ct-masthead,
  [data-theme="light"] .ct-slice-control {
    background: #EDE8DC;
  }
</style>

<script>
  function initThreeCTVolume() {
    const container = document.getElementById('ct-canvas-container');
    const canvas = document.getElementById('three-ct-canvas') as HTMLCanvasElement | null;
    const fallback = document.getElementById('ct-fallback');
    const slider = document.getElementById('ct-slice-slider') as HTMLInputElement | null;
    const readout = document.getElementById('ct-slice-readout');
    if (!container || !canvas) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (fallback) fallback.style.display = 'flex';
      return;
    }

    let isInitialized = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !isInitialized) {
          isInitialized = true;
          observer.disconnect();
          loadCTModel();
        }
      });
    }, { threshold: 0.05 });

    observer.observe(container);

    async function loadCTModel() {
      try {
        const THREE = await import('three');

        const width = container!.clientWidth || 400;
        const height = container!.clientHeight || 340;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(42, width / height, 1, 1000);
        camera.position.set(90, 80, 130);
        camera.lookAt(0, 0, 0);

        const renderer = new THREE.WebGLRenderer({
          canvas: canvas!,
          alpha: true,
          antialias: true,
          powerPreference: 'low-power'
        });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

        const ambientLight = new THREE.AmbientLight(0xffffff, 1.2);
        scene.add(ambientLight);

        const dirLight = new THREE.DirectionalLight(0x38bdf8, 1.8);
        dirLight.position.set(80, 100, 60);
        scene.add(dirLight);

        const volumeGroup = new THREE.Group();
        scene.add(volumeGroup);

        // Bounding Volume Wireframe Box
        const boxGeo = new THREE.BoxGeometry(70, 90, 70);
        const boxEdgeGeo = new THREE.EdgesGeometry(boxGeo);
        const boxEdgeMat = new THREE.LineBasicMaterial({
          color: 0x38bdf8,
          transparent: true,
          opacity: 0.35
        });
        const boxWire = new THREE.LineSegments(boxEdgeGeo, boxEdgeMat);
        volumeGroup.add(boxWire);

        // Shepp-Logan Translucent Head Phantom (Ellipsoid)
        const skullGeo = new THREE.SphereGeometry(30, 24, 24);
        skullGeo.scale(1.0, 1.35, 1.0);
        const skullMat = new THREE.MeshStandardMaterial({
          color: 0x0284c7,
          transparent: true,
          opacity: 0.22,
          roughness: 0.3,
          metalness: 0.1,
          wireframe: false
        });
        const skull = new THREE.Mesh(skullGeo, skullMat);
        volumeGroup.add(skull);

        // Brain Tissue Inner Core
        const brainGeo = new THREE.SphereGeometry(25, 20, 20);
        brainGeo.scale(1.0, 1.3, 0.95);
        const brainMat = new THREE.MeshStandardMaterial({
          color: 0x38bdf8,
          transparent: true,
          opacity: 0.15,
          roughness: 0.5
        });
        const brain = new THREE.Mesh(brainGeo, brainMat);
        volumeGroup.add(brain);

        // High-Density Tumour Neoplasm Core
        const tumourGeo = new THREE.SphereGeometry(7.5, 16, 16);
        const tumourMat = new THREE.MeshStandardMaterial({
          color: 0xf59e0b,
          emissive: 0xd97706,
          emissiveIntensity: 0.6,
          roughness: 0.2
        });
        const tumour = new THREE.Mesh(tumourGeo, tumourMat);
        tumour.position.set(-8, 5, 6);
        volumeGroup.add(tumour);

        // Movable Axial Slice Plane (Square in X-Z)
        const sliceGeo = new THREE.PlaneGeometry(68, 68);
        sliceGeo.rotateX(-Math.PI / 2); // Lay horizontal in X-Z plane
        const sliceMat = new THREE.MeshBasicMaterial({
          color: 0xf59e0b,
          transparent: true,
          opacity: 0.35,
          side: THREE.DoubleSide
        });
        const slicePlane = new THREE.Mesh(sliceGeo, sliceMat);
        volumeGroup.add(slicePlane);

        // Slicing Plane Perimeter Border
        const sliceEdgeGeo = new THREE.EdgesGeometry(sliceGeo);
        const sliceEdgeMat = new THREE.LineBasicMaterial({
          color: 0xf59e0b,
          linewidth: 2
        });
        const sliceEdge = new THREE.LineSegments(sliceEdgeGeo, sliceEdgeMat);
        slicePlane.add(sliceEdge);

        // Slicing Depth Control
        let sliceY = 0;
        slider?.addEventListener('input', () => {
          sliceY = parseFloat(slider.value);
          slicePlane.position.y = sliceY;
          if (readout) {
            readout.textContent = `Z-SLICE: ${sliceY > 0 ? '+' : ''}${sliceY.toFixed(1)} mm · 256³ VOXELS`;
          }
        });

        // Mouse Drag to Orbit Volume
        let isDragging = false;
        let prevMouseX = 0;
        let prevMouseY = 0;
        let rotY = 0.6;
        let rotX = 0.35;

        container!.addEventListener('mousedown', (e) => {
          isDragging = true;
          prevMouseX = e.clientX;
          prevMouseY = e.clientY;
        });

        window.addEventListener('mouseup', () => {
          isDragging = false;
        });

        window.addEventListener('mousemove', (e) => {
          if (!isDragging) return;
          const deltaX = e.clientX - prevMouseX;
          const deltaY = e.clientY - prevMouseY;
          prevMouseX = e.clientX;
          prevMouseY = e.clientY;

          rotY += deltaX * 0.01;
          rotX += deltaY * 0.01;
          // Clamp X rotation to avoid flipping upside down
          rotX = Math.max(-Math.PI / 3, Math.min(Math.PI / 3, rotX));
        });

        let animId = 0;
        let isVisible = true;

        const visObserver = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            isVisible = e.isIntersecting;
            if (isVisible && !animId) animate();
          });
        }, { threshold: 0.05 });
        visObserver.observe(container!);

        function animate() {
          if (!isVisible) {
            animId = 0;
            return;
          }

          // Gentle autonomous rotation when not dragging
          if (!isDragging) {
            rotY += 0.003;
          }

          volumeGroup.rotation.y = rotY;
          volumeGroup.rotation.x = rotX;

          // Pulse tumour slightly
          const pulse = Math.sin(Date.now() * 0.004) * 0.15 + 1.0;
          tumour.scale.set(pulse, pulse, pulse);

          renderer.render(scene, camera);
          animId = requestAnimationFrame(animate);
        }

        animate();

        function handleResize() {
          if (!container) return;
          const w = container.clientWidth || 400;
          const h = container.clientHeight || 340;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h);
        }

        window.addEventListener('resize', handleResize, { passive: true });

        document.addEventListener('astro:before-swap', () => {
          cancelAnimationFrame(animId);
          window.removeEventListener('resize', handleResize);
          visObserver.disconnect();
          renderer.dispose();
        }, { once: true });

      } catch (err) {
        console.warn('[ThreeCTVolume] Fallback rendered:', err);
        if (fallback) fallback.style.display = 'flex';
      }
    }
  }

  initThreeCTVolume();
  document.addEventListener('astro:page-load', initThreeCTVolume);
</script>
