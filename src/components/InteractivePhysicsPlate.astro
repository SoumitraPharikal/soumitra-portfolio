        slider.max = '1.560';
        slider.step = '0.0005';
        slider.value = paramPhotometry.toFixed(4);
        const isResonance = Math.abs(paramPhotometry - 1.4820) < 0.002;
        const detune = Math.abs(paramPhotometry - 1.4820);
