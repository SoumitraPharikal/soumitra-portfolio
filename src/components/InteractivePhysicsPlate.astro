    border: 1px solid #E2E8F0 !important;
    color: #14181F !important;
    box-shadow: 0 12px 32px -8px rgba(20, 24, 31, 0.08) !important;
  }

  :global(html[data-theme="light"]) .plate-toolbar,
  :global(html[data-theme="light"]) .plate-footer {
    background: #F8F7F2 !important;
    border-color: #E2E8F0 !important;
