---
// src/components/InteractivePhysicsPlate.astro
// Self-contained 60 FPS HTML5 Canvas Scientific Instrument:
// Mode 01: Time-Series Photometry & Exoplanet Transit Mini-Schematic (IC 1369)
// Mode 02: Kerr Black Hole Spacetime Geodesic & Relativistic Curvature Well
// Mode 03: Autonomous Radon CT Gantry Sweep & Sinogram Reconstructions (Ram-Lak vs Unfiltered)
// Mode 04: Continuous Monte Carlo Stochastic Decay & 8x8 Lattice Fit
---

<div class="physics-plate hairline-box spotlight-card corner-crosshair border-beam-card no-tilt" id="physics-instrument-container">
  <!-- Top Instrument Masthead Toolbar -->
  <div class="plate-toolbar hairline-bottom">
    <div class="plate-title-group">
      <span class="pulse-dot" aria-hidden="true"></span>
      <span class="mono-label">INTERACTIVE PHYSICS LAB</span>
      <div class="status-indicator-pill mono" id="status-indicator">
        <span class="status-ping"></span>
        <span id="status-text">REAL-TIME ENGINE</span>
      </div>
    </div>

    <!-- 4 Clean Short Mode Pills with Verified Physics Tooltips -->
    <div class="plate-mode-tabs" role="tablist" aria-label="Instrument Simulation Modes">
      <button
        type="button"
        class="mode-pill is-active"
        id="btn-mode-photometry"
        role="tab"
        aria-selected="true"
        tabindex="0"
        data-mode="photometry"
        title="Mode 01: Aperture photometry light curve phase-folded via String-Length minimization on IC 1369 variable stars."
      >
        <span class="mode-number">01</span> Photometry
      </button>
      <button
        type="button"
        class="mode-pill"
        id="btn-mode-nbody"
        role="tab"
        aria-selected="false"
        tabindex="-1"
        data-mode="nbody"
        title="Mode 02: Kerr black hole spacetime curvature & relativistic rosette orbital dynamics with interactive 3D drag perspective."
      >
        <span class="mode-number">02</span> Kerr Orbit
      </button>
      <button
        type="button"
        class="mode-pill"
        id="btn-mode-radon"
        role="tab"
        aria-selected="false"
        tabindex="-1"
        data-mode="radon"
        title="Mode 03: Continuous projection line integrals through Radon transform Rf(θ, s) reconstructed via Ram-Lak filtered backprojection."
      >
        <span class="mode-number">03</span> Radon CT
      </button>
      <button
        type="button"
        class="mode-pill"
        id="btn-mode-mc"
        role="tab"
        aria-selected="false"
        tabindex="-1"
        data-mode="mc"
        title="Mode 04: Stochastic kinetic decay across 8x8 radioisotope lattice with live half-life exponential fitting."
      >
        <span class="mode-number">04</span> Monte Carlo
      </button>
    </div>
  </div>

  <!-- Dynamic Physics Caption Strip with Contextual Mode Controls -->
  <div class="plate-caption-strip mono" id="plate-caption-strip">
    <div class="caption-left">
      <span class="caption-icon" aria-hidden="true">◈</span>
      <span id="plate-caption-text">Mode 01: IC 1369 Phase-Folded Photometry</span>
    </div>
    <div class="caption-right">
      <button
        type="button"
        class="mini-control-btn mono"
        id="radon-filter-btn"
        style="display: none;"
        title="Toggle between Ram-Lak Ramp Filtered vs Unfiltered 1/r Backprojection"
      >
        FILTER: <span id="radon-filter-label">RAM-LAK</span>
      </button>
      <button
        type="button"
        class="mini-control-btn mono"
        id="fold-cycle-btn"
        title="Trigger 300ms Phase-Fold Reveal Animation"
      >
        ANIMATE: <span id="fold-cycle-label">PHASE FOLD</span>
      </button>
    </div>
  </div>

  <!-- Canvas Viewport (Fixed 320px Height) -->
  <div class="canvas-viewport" id="canvas-wrapper">
    <canvas id="physics-canvas" width="560" height="320" aria-label="Interactive Astrophysics and Computational Simulation Plate"></canvas>
    <!-- 3D Drag Rotation Hint Pill -->
    <div class="drag-3d-hint-pill mono" id="drag-3d-hint" style="display: none;" aria-hidden="true">
      <span class="drag-hint-icon">✥</span> 3D DRAG ENABLED
    </div>
    <div class="canvas-grid-overlay" aria-hidden="true">
      <span class="coord-tag coord-tl mono" id="coord-grid-tag">METHOD: DAOPHOT PSF · LOMB-SCARGLE</span>
    </div>
  </div>

  <!-- Single-Line Bottom Footer: Parameter Slider on Left, 2 Metric Badges on Right -->
  <div class="plate-footer hairline-top">
    <div class="slider-control-group">
      <label for="instrument-slider" class="fine-label mono" id="slider-label">TRIAL PERIOD P:</label>
      <div class="tactile-range-wrapper">
        <input
          type="range"
          id="instrument-slider"
          min="0.8"
          max="1.2"
          step="0.001"
          value="1.0"
          class="fine-range tactile-slider"
          aria-label="Instrument Parameter Scrubber"
        />
      </div>
      <span class="fine-readout mono" id="slider-readout">1.4820 d (Best-Fit Period)</span>
    </div>

    <div class="metrics-group">
      <div class="plate-metric-badge mono" id="metric-badge-1">
        <span class="metric-dot dot-cyan"></span>
        <span id="metric-val-1">PHASE RMS: 0.014 mag</span>
      </div>
      <div class="plate-metric-badge mono" id="metric-badge-2">
        <span class="metric-dot dot-gold"></span>
        <span id="metric-val-2">PERIOD: 1.482 d</span>
      </div>
    </div>
  </div>
</div>

<style>
  .physics-plate {
    background-color: var(--bg-surface);
