        slider.step = '0.01';
        slider.value = paramNbody.toFixed(2);
        const orbitType = paramNbody < 0.08 ? 'Circular Photon Orbit' : (paramNbody < 0.38 ? 'Bound Relativistic' : 'Rosetta Precession');
        sliderReadout.textContent = `e = ${paramNbody.toFixed(2)} (${orbitType})`;
        metricVal1.textContent = 'INTEGRATOR: HAMILTONIAN RK4';
