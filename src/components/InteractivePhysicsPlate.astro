    };

    // Aria labels for accessibility
    const ariaLabels: Record<PlateMode, string> = {
      photometry: 'Aperture photometry simulation showing light curve phase-folded onto 1.4820 days period with photon transit schematic.',
      nbody: 'Interactive Kerr black hole spacetime curvature simulation with 3D draggable potential well and frame-dragged rosette orbital trajectory.',
      radon: 'Radon transform tomography simulation sweeping projection rays through Shepp-Logan phantom into sinogram with Ram-Lak ramp filtering.',
      mc: 'Monte Carlo stochastic decay simulation across an 8x8 radioisotope lattice with live non-linear exponential half-life fitting.'
    };

    function triggerFoldReveal() {
      isFoldAnimating = true;
      foldAnimStartTime = Date.now();
      foldAnimTarget = foldProgress < 0.5 ? 1.0 : 0.0;
