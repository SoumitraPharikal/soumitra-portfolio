        const dy = e.touches[0].clientY - lastDragY;
        yaw3D += dx * 0.012;
        pitch3D = Math.max(0.18, Math.min(1.25, pitch3D + dy * 0.012));
        lastDragX = e.touches[0].clientX;
        lastDragY = e.touches[0].clientY;
      }
    }, { passive: true });

    window.addEventListener('touchend', () => {
