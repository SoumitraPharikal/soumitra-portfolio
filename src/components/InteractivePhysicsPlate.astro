    const btnRadon = document.getElementById('btn-mode-radon');
    const btnMc = document.getElementById('btn-mode-mc');
    const modeBtns = [btnPhotometry, btnNbody, btnRadon, btnMc];

    // Contextual buttons
    const radonFilterBtn = document.getElementById('radon-filter-btn') as HTMLButtonElement | null;
    const radonFilterLabel = document.getElementById('radon-filter-label');
    const foldCycleBtn = document.getElementById('fold-cycle-btn') as HTMLButtonElement | null;
