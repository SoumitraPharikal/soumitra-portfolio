    border: 2px solid #FFFFFF !important;
    box-shadow: 0 2px 6px rgba(217, 119, 6, 0.4) !important;
  }

  :global(html[data-theme="light"]) .tactile-slider::-moz-range-thumb {
    background: #D97706 !important;
    border: 2px solid #FFFFFF !important;
  }

  :global(html[data-theme="light"]) .mode-pill {
    background: #EFECE6 !important;
    border: 1px solid #E2E8F0 !important;
    color: #475569 !important;
  }

  :global(html[data-theme="light"]) .mode-pill .mode-number {
