    let isDragging3D = false;
    let lastDragX = 0;
    let lastDragY = 0;

    function project3D(x: number, y: number, z: number, cx: number, cy: number, scale = 1.0) {
      const cosZ = Math.cos(yaw3D);
      const sinZ = Math.sin(yaw3D);
      const x1 = x * cosZ - y * sinZ;
      const y1 = x * sinZ + y * cosZ;
      const z1 = z;

      const cosX = Math.cos(pitch3D);
      const sinX = Math.sin(pitch3D);
      const y2 = y1 * cosX - z1 * sinX;
      const z2 = y1 * sinX + z1 * cosX;
      const x2 = x1;

      const cameraDist = 480;
      const fov = cameraDist / (cameraDist + z2);
      return {
        x: cx + x2 * fov * scale,
        y: cy + y2 * fov * scale,
        depth: z2,
        fov
      };
    }

    let width = 560;
    let height = 320;

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      width = Math.floor(rect.width);
      height = Math.floor(rect.height);
