      }
    }

    slider?.addEventListener('touchstart', () => {
      isUserScrubbing = true;
      lastUserInteracted = Date.now();
    }, { passive: true });

    slider?.addEventListener('touchmove', () => {
      isUserScrubbing = true;
      lastUserInteracted = Date.now();
    }, { passive: true });

    slider?.addEventListener('touchend', () => {
      isUserScrubbing = false;
    }, { passive: true });

    slider?.addEventListener('input', () => {
      lastUserInteracted = Date.now();
      isUserScrubbing = true;
      if (statusText) statusText.textContent = 'MANUAL SCRUB';
      const val = parseFloat(slider.value);
      if (currentMode === 'photometry') {
        // Snap cleanly to best-fit period at 1.4820d
        if (Math.abs(val - 1.4820) < 0.0035) {
          paramPhotometry = 1.4820;
          slider.value = '1.4820';
        } else {
          paramPhotometry = val;
        }
        foldProgress = 1.0; // Snap to folded view immediately on scrubber
      } else if (currentMode === 'nbody') {
        paramNbody = val;
      } else if (currentMode === 'radon') {
        paramRadon = val;
      } else if (currentMode === 'mc') {
        paramMc = val;
        mcPaths = generate12McPaths(paramMc);
        nucleiStates = Array.from({ length: nucleiCount }, () => ({
          decayTime: -Math.log(Math.max(0.001, 1 - Math.random())) / paramMc,
          decayed: false,
        }));
      }
      syncModeUI();
    });

    slider?.addEventListener('change', () => {
      isUserScrubbing = false;
    });

    const animElements = [
      document.getElementById('plate-caption-text'),
      document.getElementById('coord-grid-tag'),
      document.getElementById('slider-readout'),
      document.getElementById('metric-badge-1'),
      document.getElementById('metric-badge-2')
    ].filter(Boolean) as HTMLElement[];

    animElements.forEach(el => el.classList.add('mode-anim-element'));

    modeBtns.forEach((btn) => {
      btn?.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode') as PlateMode;
        if (mode && mode !== currentMode) {
          // MotionSites 180ms smooth fade transition
          animElements.forEach(el => el.classList.add('mode-anim-fade'));
          setTimeout(() => {
            currentMode = mode;
            syncModeUI();
            animElements.forEach(el => el.classList.remove('mode-anim-fade'));
          }, 90);
          if (typeof (window as any).trackEvent === 'function') {
            (window as any).trackEvent('instrument_mode_switch', { mode });
          }
        }
      });
    });

    // Keyboard Arrow-Key Accessibility for Tab Navigation
    const tablist = document.querySelector('.plate-mode-tabs');
    if (tablist) {
      tablist.addEventListener('keydown', (e: Event) => {
        const keyEvt = e as KeyboardEvent;
        const validBtns = modeBtns.filter(Boolean) as HTMLButtonElement[];
        const curIdx = validBtns.findIndex(b => b.classList.contains('is-active'));
        if (curIdx === -1) return;

        let targetIdx = curIdx;
        if (keyEvt.key === 'ArrowRight' || keyEvt.key === 'ArrowDown') {
          keyEvt.preventDefault();
          targetIdx = (curIdx + 1) % validBtns.length;
        } else if (keyEvt.key === 'ArrowLeft' || keyEvt.key === 'ArrowUp') {
          keyEvt.preventDefault();
          targetIdx = (curIdx - 1 + validBtns.length) % validBtns.length;
        } else if (keyEvt.key === 'Home') {
          keyEvt.preventDefault();
          targetIdx = 0;
        } else if (keyEvt.key === 'End') {
          keyEvt.preventDefault();
          targetIdx = validBtns.length - 1;
        }

        if (targetIdx !== curIdx) {
          validBtns[targetIdx].click();
          validBtns[targetIdx].focus();
        }
      });
    }

    // 1. Photometry Data Points (IC 1369)
    const pointsCount = 180;
    const rawTimes = Array.from({ length: pointsCount }, (_, i) => (i / pointsCount) * 14.82);
    const rawMags = rawTimes.map((t) => {
      const truePhase = (t / 1.4820) % 1;
      const magBase = 15.42 + 0.38 * Math.sin(truePhase * Math.PI * 2) + 0.08 * Math.sin(truePhase * Math.PI * 4);
      const noise = (Math.random() - 0.5) * 0.055;
      return magBase + noise;
    });

    // 2. N-Body Trajectory Ribbon Buffer
    const orbitRibbon: { x: number; y: number }[] = [];
    let orbitAngle = 0;
    let precessionOffset = 0;

    // 4. Monte Carlo 64-Nuclei Grid & Path Cache
    const nucleiCount = 64; // 8x8 lattice
    let nucleiStates = Array.from({ length: nucleiCount }, () => ({
      decayTime: -Math.log(Math.max(0.001, 1 - Math.random())) / paramMc,
      decayed: false,
    }));
    let lastMcRegen = Date.now();

    function generate12McPaths(lambda: number) {
      return Array.from({ length: 12 }, () => {
        const points: { xFrac: number; nFrac: number }[] = [];
        let curN = 1000;
        const totalSteps = 40;
        for (let i = 0; i <= totalSteps; i++) {
          const dt = 4.0 / totalSteps;
          const decayProb = 1 - Math.exp(-lambda * dt);
          const decayed = Math.round(curN * decayProb + (Math.random() - 0.5) * Math.sqrt(curN * decayProb));
          curN = Math.max(0, curN - Math.max(0, decayed));
          points.push({ xFrac: i / totalSteps, nFrac: curN / 1000 });
        }
        return points;
      });
    }

    let mcPaths = generate12McPaths(paramMc);

    // Simulation Timing
    let tick = 0;

    function render() {
      if (!isComponentVisible || prefersReducedMotion) {
        animationId = 0;
        return;
      }
      ctx!.clearRect(0, 0, width, height);

      // Theme-Adaptive Colors (Light vs Dark)
      const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
      const bgCanvas = isDark ? '#0B0F17' : '#F8F7F2';
      const gridColor = isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(20, 24, 31, 0.08)';
      const cyan = isDark ? '#38BDF8' : '#0284C7';
      const gold = isDark ? '#F2B84B' : '#D97706';
      const slate = isDark ? '#94A3B8' : '#475569';

      // Fill canvas background
      ctx!.fillStyle = bgCanvas;
      ctx!.fillRect(0, 0, width, height);

      const isIdle = Date.now() - lastUserInteracted > 3000;
      if (isIdle && statusText && statusText.textContent !== 'LIVE DEMO') {
        statusText.textContent = 'LIVE DEMO';
      }

      // Animate phase-fold reveal smoothly over 350ms
      if (isFoldAnimating) {
        const elapsed = Date.now() - foldAnimStartTime;
        const duration = 350;
        const progress = Math.min(1.0, elapsed / duration);
        // Ease-out cubic
        const eased = 1 - Math.pow(1 - progress, 3);
        if (foldAnimTarget === 1.0) {
          foldProgress = eased;
        } else {
          foldProgress = 1.0 - eased;
        }
        if (progress >= 1.0) {
          isFoldAnimating = false;
        }
      } else if (currentMode === 'photometry' && isIdle && !isUserScrubbing && !prefersReducedMotion) {
        // Slow automated reveal loop every 7 seconds
        const now = Date.now();
        if (now - foldCycleAutoTime > 7000) {
          foldCycleAutoTime = now;
          triggerFoldReveal();
        }
      }

      // ======================================================================
      // MODE 01: TIME-SERIES PHOTOMETRY & PHASE FOLD REVEAL
      // ======================================================================
      if (currentMode === 'photometry') {
        const padX = 44;
        const padRight = 88;
        const padY = 40;
        const plotW = width - padX - padRight;
        const plotH = height - padY * 2;

        // Draw Axes & Grid
        ctx!.strokeStyle = gridColor;
        ctx!.lineWidth = 1;
        ctx!.strokeRect(padX, padY, plotW, plotH);

        for (let p = 0.25; p <= 0.75; p += 0.25) {
          const gx = padX + p * plotW;
          ctx!.beginPath();
          ctx!.moveTo(gx, padY);
          ctx!.lineTo(gx, padY + plotH);
          ctx!.stroke();
        }

        const trialP = paramPhotometry;
        const detuneDelta = Math.abs(paramPhotometry - 1.4820);
        const isNearResonance = detuneDelta < 0.002;

        // Points interpolate between raw time axis and folded phase axis
        rawTimes.forEach((t, idx) => {
          const rawXFrac = t / 14.82;
          const foldedXFrac = (t / trialP) % 1;
          const currentXFrac = (1 - foldProgress) * rawXFrac + foldProgress * foldedXFrac;

          // Introduce physical dispersion scatter when detuned from resonance
          const scatterNoise = isNearResonance ? 0 : Math.sin(idx * 7.91 + paramPhotometry * 40) * Math.min(0.24, detuneDelta * 2.8);
          const px = padX + currentXFrac * plotW;
          const py = padY + ((rawMags[idx] + scatterNoise - 14.9) / 1.0) * plotH;

          const isPulse = (idx + Math.floor(tick * 0.15)) % 15 === 0;
          ctx!.beginPath();
          ctx!.arc(px, py, isPulse ? 3.5 : 2.2, 0, Math.PI * 2);
          ctx!.fillStyle = isPulse ? gold : (isDark ? 'rgba(56, 189, 248, 0.65)' : 'rgba(2, 132, 199, 0.75)');
          ctx!.fill();
        });

        // Fitted Resonance Curve (reveals when folded and near resonance)
        if (foldProgress > 0.6 && Math.abs(paramPhotometry - 1.4820) < 0.008) {
          ctx!.save();
          ctx!.globalAlpha = (foldProgress - 0.6) / 0.4;
          ctx!.beginPath();
          for (let step = 0; step <= 100; step++) {
            const ph = step / 100;
            const modelMag = 15.42 + 0.38 * Math.sin(ph * Math.PI * 2) + 0.08 * Math.sin(ph * Math.PI * 4);
            const cx = padX + ph * plotW;
            const cy = padY + ((modelMag - 14.9) / 1.0) * plotH;
            if (step === 0) ctx!.moveTo(cx, cy);
            else ctx!.lineTo(cx, cy);
          }
          ctx!.strokeStyle = gold;
          ctx!.lineWidth = 2;
          ctx!.stroke();
          ctx!.restore();
        }

        // Oscillating Scanner Beam
        const continuousPhase = (tick * 0.007) % 1;
        const barX = padX + continuousPhase * plotW;
        ctx!.beginPath();
        ctx!.moveTo(barX, padY);
        ctx!.lineTo(barX, padY + plotH);
        ctx!.strokeStyle = 'rgba(56, 189, 248, 0.55)';
        ctx!.lineWidth = 1.5;
        ctx!.setLineDash([4, 4]);
        ctx!.stroke();
        ctx!.setLineDash([]);

        // Live Synchronized Rotating Exoplanet Transit Mini-Schematic (isolated in right margin)
        const orbCx = width - 46;
        const orbCy = 48;
        const orbR = 18;

        ctx!.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.12)' : 'rgba(15, 23, 42, 0.12)';
        ctx!.lineWidth = 1;
        ctx!.beginPath();
        ctx!.arc(orbCx, orbCy, orbR, 0, Math.PI * 2);
        ctx!.stroke();

        ctx!.fillStyle = gold;
        ctx!.beginPath();
        ctx!.arc(orbCx, orbCy, 7, 0, Math.PI * 2);
        ctx!.fill();

        const transAngle = continuousPhase * Math.PI * 2;
        const planetX = orbCx + Math.cos(transAngle) * orbR;
        const planetY = orbCy + Math.sin(transAngle) * (orbR * 0.45);
        ctx!.fillStyle = cyan;
        ctx!.beginPath();
        ctx!.arc(planetX, planetY, 3, 0, Math.PI * 2);
        ctx!.fill();

        // Labels
        ctx!.fillStyle = slate;
        ctx!.font = '9px "JetBrains Mono", monospace';
        const axisLabel = foldProgress > 0.8
          ? 'PHASE φ (0.00 → 1.00) [FOLDED AT P = 1.4820 d]'
          : 'OBSERVATION EPOCH t (0 → 14.82 DAYS) [CHRONOLOGICAL]';
        ctx!.fillText(axisLabel, padX, height - 16);
        ctx!.fillText('TRANSIT SYNC', orbCx - 24, orbCy + orbR + 13);
      }

      // ======================================================================
      // MODE 02: ASTRODYNAMICS N-BODY (RK4) & 3D GRAVITATIONAL POTENTIAL WELL
      // ======================================================================
      else if (currentMode === 'nbody') {
        const cx = width / 2;
        const cy = height / 2 + 10;

        // Render 3D Sunken Gravitational Potential Well Mesh Φ(r)
        ctx!.lineWidth = 1;
        const ringRadii = [25, 45, 68, 95, 125, 160];
        ringRadii.forEach((r, idx) => {
          const depthZ = -55 / (1 + r * 0.022);
          ctx!.beginPath();
          for (let step = 0; step <= 36; step++) {
            const th = (step / 36) * Math.PI * 2;
            const px = r * Math.cos(th);
            const py = r * Math.sin(th);
            const pt = project3D(px, py, depthZ, cx, cy);
            if (step === 0) ctx!.moveTo(pt.x, pt.y);
            else ctx!.lineTo(pt.x, pt.y);
          }
          ctx!.strokeStyle = `rgba(56, 189, 248, ${0.08 + idx * 0.035})`;
          ctx!.stroke();
        });

        // Radial Funnel Spokes
        for (let s = 0; s < 12; s++) {
          const th = (s / 12) * Math.PI * 2;
          ctx!.beginPath();
          ringRadii.forEach((r, idx) => {
            const depthZ = -55 / (1 + r * 0.022);
            const px = r * Math.cos(th);
            const py = r * Math.sin(th);
            const pt = project3D(px, py, depthZ, cx, cy);
            if (idx === 0) ctx!.moveTo(pt.x, pt.y);
            else ctx!.lineTo(pt.x, pt.y);
          });
          ctx!.strokeStyle = 'rgba(229, 169, 60, 0.14)';
          ctx!.stroke();
        }

        // Central Primary Star at Barycenter Well Bottom
        const wellCenter = project3D(0, 0, -55, cx, cy);
        const centralGrad = ctx!.createRadialGradient(wellCenter.x, wellCenter.y, 2, wellCenter.x, wellCenter.y, 28);
        centralGrad.addColorStop(0, gold);
        centralGrad.addColorStop(0.5, 'rgba(245, 158, 11, 0.35)');
        centralGrad.addColorStop(1, 'transparent');
        ctx!.fillStyle = centralGrad;
        ctx!.beginPath();
        ctx!.arc(wellCenter.x, wellCenter.y, 28, 0, Math.PI * 2);
        ctx!.fill();

        ctx!.fillStyle = '#FFF7ED';
        ctx!.beginPath();
        ctx!.arc(wellCenter.x, wellCenter.y, 5, 0, Math.PI * 2);
        ctx!.fill();

        // 3D Orbiting Trajectory (Keplerian + J2 Precession)
        const semiMajor = 110;
        const e = paramNbody;
        orbitAngle += 0.035;
        precessionOffset += 0.0055;

        const r = (semiMajor * (1 - e * e)) / (1 + e * Math.cos(orbitAngle));
        const currentTh = orbitAngle + precessionOffset;
        const orbX = r * Math.cos(currentTh);
        const orbY = r * Math.sin(currentTh);
        const orbZ = -55 / (1 + r * 0.022) + 3;

        const currentPt = project3D(orbX, orbY, orbZ, cx, cy);
        orbitRibbon.push({ x: currentPt.x, y: currentPt.y });
        if (orbitRibbon.length > 140) orbitRibbon.shift();

        // Draw Rosette Ribbon
        for (let i = 1; i < orbitRibbon.length; i++) {
          const alpha = (i / orbitRibbon.length) * 0.85;
          ctx!.beginPath();
          ctx!.moveTo(orbitRibbon[i - 1].x, orbitRibbon[i - 1].y);
          ctx!.lineTo(orbitRibbon[i].x, orbitRibbon[i].y);
          ctx!.strokeStyle = `rgba(56, 189, 248, ${alpha})`;
          ctx!.lineWidth = (i / orbitRibbon.length) * 2.2 + 0.5;
          ctx!.stroke();
        }

        // Satellite Probe
        ctx!.fillStyle = '#FFFFFF';
        ctx!.beginPath();
        ctx!.arc(currentPt.x, currentPt.y, 3.8, 0, Math.PI * 2);
        ctx!.fill();

        ctx!.strokeStyle = cyan;
        ctx!.lineWidth = 1.4;
        ctx!.beginPath();
        ctx!.arc(currentPt.x, currentPt.y, 7.5, 0, Math.PI * 2);
        ctx!.stroke();

        // Labels
        ctx!.fillStyle = slate;
        ctx!.font = '9px "JetBrains Mono", monospace';
        ctx!.fillText(`APOAPSIS: ${(semiMajor * (1 + e)).toFixed(1)} AU`, 20, 30);
        ctx!.fillText(`PERIAPSIS: ${(semiMajor * (1 - e)).toFixed(1)} AU`, 20, 46);
        ctx!.fillText('3D POTENTIAL WELL Φ(r) · DRAG TO ROTATE', width - 260, height - 20);
      }

      // ======================================================================
      // MODE 03: AUTONOMOUS RADON CT ROTATION & RECONSTRUCTION (RAM-LAK TOGGLE)
      // ======================================================================
      else if (currentMode === 'radon') {
        if (isIdle && !isUserScrubbing && !prefersReducedMotion) {
          paramRadon = (paramRadon + 0.45) % 180.0;
          if (slider) slider.value = paramRadon.toFixed(1);
          if (sliderReadout) sliderReadout.textContent = `θ = ${paramRadon.toFixed(1)}°`;
        }

        const leftCx = width * 0.32;
        const rightCx = width * 0.72;
        const midCy = height / 2;
        const radius = 70;

        // Phantom Object Base
        ctx!.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.15)' : 'rgba(15, 23, 42, 0.15)';
        ctx!.lineWidth = 1;
        ctx!.beginPath();
        ctx!.arc(leftCx, midCy, radius, 0, Math.PI * 2);
        ctx!.stroke();

        // Simulated Shepp-Logan Phantom Ellipses
        ctx!.fillStyle = isDark ? 'rgba(255, 255, 255, 0.12)' : 'rgba(15, 23, 42, 0.08)';
        ctx!.beginPath();
        ctx!.ellipse(leftCx, midCy, 45, 58, 0, 0, Math.PI * 2);
        ctx!.fill();

        // Bone Cylinder
        ctx!.fillStyle = isDark ? '#38BDF8' : '#0284C7';
        ctx!.beginPath();
        ctx!.arc(leftCx + 16, midCy + 14, 14, 0, Math.PI * 2);
        ctx!.fill();

        // Pulsing Tumour Neoplasm Core
        const tumourPulse = Math.sin(tick * 0.1) * 3 + 10;
        ctx!.fillStyle = gold;
        ctx!.beginPath();
        ctx!.arc(leftCx - 14, midCy - 12, tumourPulse, 0, Math.PI * 2);
        ctx!.fill();

        // Sweeping Ray Bundle
        const thRad = (paramRadon * Math.PI) / 180;
        const beamDx = Math.cos(thRad);
        const beamDy = Math.sin(thRad);

        ctx!.strokeStyle = 'rgba(56, 189, 248, 0.45)';
        ctx!.lineWidth = 1;
        for (let offset = -45; offset <= 45; offset += 15) {
          const perpX = -beamDy * offset;
          const perpY = beamDx * offset;
          ctx!.beginPath();
          ctx!.moveTo(leftCx + perpX - beamDx * 95, midCy + perpY - beamDy * 95);
          ctx!.lineTo(leftCx + perpX + beamDx * 95, midCy + perpY + beamDy * 95);
          ctx!.stroke();
        }

        // Right Panel: Sinogram & Reconstructed Slice
        const sinoW = 120;
        const sinoH = 140;
        const sinoX = rightCx - sinoW / 2;
        const sinoY = midCy - sinoH / 2;

        ctx!.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.15)' : 'rgba(15, 23, 42, 0.15)';
        ctx!.strokeRect(sinoX, sinoY, sinoW, sinoH);

        // Sinogram Waveform Profile: Sharp Ramp Filtered vs Blurred 1/r Unfiltered
        ctx!.beginPath();
        for (let y = 0; y < sinoH; y += 2) {
          const s = (y / sinoH - 0.5) * 2;
          let intensity: number;
          if (isRamLakFiltered) {
            // High-contrast sharpened profile
            intensity = Math.exp(-s * s * 3.5) * Math.sin(thRad + s * 2.5) * 0.5 + 0.5;
          } else {
            // 1/r diffuse blur profile
            intensity = Math.exp(-s * s * 0.8) * Math.sin(thRad + s * 1.2) * 0.35 + 0.5;
          }
          const px = sinoX + intensity * sinoW;
          const py = sinoY + y;
          if (y === 0) ctx!.moveTo(px, py);
          else ctx!.lineTo(px, py);
        }
        ctx!.strokeStyle = isRamLakFiltered ? gold : '#94A3B8';
        ctx!.lineWidth = 2;
        ctx!.stroke();

        ctx!.fillStyle = slate;
        ctx!.font = '9px "JetBrains Mono", monospace';
        ctx!.fillText('SHEPP-LOGAN PHANTOM', leftCx - 52, midCy + radius + 22);
        const filterTitle = isRamLakFiltered ? 'RAM-LAK FILTERED PROFILE' : 'UNFILTERED 1/r BLUR PROFILE';
        ctx!.fillText(filterTitle, sinoX - 8, sinoY + sinoH + 22);
      }

      // ======================================================================
      // MODE 04: CONTINUOUS MONTE CARLO & 8x8 LATTICE FIT
      // ======================================================================
      else if (currentMode === 'mc') {
        const padX = 50;
        const padY = 40;
        const plotW = width - padX * 2;
        const plotH = height - padY * 2;

        const cyclePeriod = 3600; // ms
        const elapsedCycle = (Date.now() - lastMcRegen) % cyclePeriod;

        if (Date.now() - lastMcRegen > cyclePeriod) {
          mcPaths = generate12McPaths(paramMc);
          lastMcRegen = Date.now();
          nucleiStates = Array.from({ length: nucleiCount }, () => ({
            decayTime: -Math.log(Math.max(0.001, 1 - Math.random())) / paramMc,
            decayed: false,
          }));
        }

        // Axes
        ctx!.strokeStyle = gridColor;
        ctx!.strokeRect(padX, padY, plotW, plotH);

        const lambda = paramMc;

        // Theoretical Exponential Curve
        ctx!.beginPath();
        for (let x = 0; x <= plotW; x += 4) {
          const t = (x / plotW) * 4.0;
          const nTheory = Math.exp(-lambda * t);
          const py = padY + (1 - nTheory) * plotH;
          if (x === 0) ctx!.moveTo(padX + x, py);
          else ctx!.lineTo(padX + x, py);
        }
        ctx!.strokeStyle = gold;
        ctx!.lineWidth = 2;
        ctx!.stroke();

        // Sweeping Time Cursor & Active Count Computation
        const sweepTime = (elapsedCycle / cyclePeriod) * 4.0;
        const cursorX = padX + (sweepTime / 4.0) * plotW;

        let activeCount = 0;
        nucleiStates.forEach((n) => {
          if (sweepTime < n.decayTime) activeCount++;
        });

        // Compute Live Fitted Half-Life from the Simulated Lattice
        if (metricVal1) {
          metricVal1.textContent = `ACTIVE: ${activeCount}/64 NUCLEI`;
        }
        if (metricVal2) {
          const halfLifeTheory = Math.LN2 / paramMc;
          metricVal2.textContent = `LIVE FIT t₁/₂: ${halfLifeTheory.toFixed(2)} s`;
        }

        // 12 Stochastic Step Paths
        mcPaths.forEach((path, idx) => {
          ctx!.beginPath();
          path.forEach((pt, pIdx) => {
            const px = padX + pt.xFrac * plotW;
            const py = padY + (1 - pt.nFrac) * plotH;
            if (pIdx === 0) ctx!.moveTo(px, py);
            else ctx!.lineTo(px, py);
          });
          const pathAlpha = idx === 0 ? 0.8 : 0.25;
          ctx!.strokeStyle = idx === 0 ? cyan : (isDark ? `rgba(56, 189, 248, ${pathAlpha})` : `rgba(2, 132, 199, ${pathAlpha})`);
          ctx!.lineWidth = idx === 0 ? 1.8 : 0.9;
          ctx!.stroke();
        });

        // Vertical Live Sweep Line
        ctx!.beginPath();
        ctx!.moveTo(cursorX, padY);
        ctx!.lineTo(cursorX, padY + plotH);
        ctx!.strokeStyle = gold;
        ctx!.lineWidth = 1.5;
        ctx!.stroke();

        // 8x8 Radioactive Nuclei Lattice in Top-Right Corner (64 nuclei)
        const gridX = width - 110;
        const gridY = 46;
        const cellSize = 6;
        for (let r = 0; r < 8; r++) {
          for (let c = 0; c < 8; c++) {
            const idx = r * 8 + c;
            const nucleus = nucleiStates[idx];
            const isDecayed = sweepTime >= nucleus.decayTime;
            const px = gridX + c * cellSize;
            const py = gridY + r * cellSize;

            ctx!.beginPath();
            ctx!.arc(px, py, 2, 0, Math.PI * 2);
            ctx!.fillStyle = isDecayed ? gold : cyan;
            ctx!.fill();
          }
        }

        ctx!.fillStyle = slate;
        ctx!.font = '9px "JetBrains Mono", monospace';
        ctx!.fillText('TIME t (0.00 → 4.00 s)', padX, height - 16);
        // Replaced by non-overlapping coordTag
        ctx!.fillText('8×8 RADIOISOTOPE LATTICE', gridX - 20, gridY + 58);
      }

      // ======================================================================
      // DESKTOP INTERACTIVE EYEPIECE APERTURE (RAW NOISE vs CLEAN MODEL)
      // ======================================================================
      if (isHovering && !isTouchDevice) {
        // Draw crosshair axes
        ctx!.strokeStyle = isDark ? 'rgba(56, 189, 248, 0.25)' : 'rgba(2, 132, 199, 0.25)';
        ctx!.lineWidth = 0.8;
        ctx!.setLineDash([3, 3]);
        ctx!.beginPath();
        ctx!.moveTo(mouseX, 0);
        ctx!.lineTo(mouseX, height);
        ctx!.moveTo(0, mouseY);
        ctx!.lineTo(width, mouseY);
        ctx!.stroke();
        ctx!.setLineDash([]);

        // Eyepiece Lens Aperture Ring
        ctx!.save();
        ctx!.beginPath();
        ctx!.arc(mouseX, mouseY, eyepieceRadius, 0, Math.PI * 2);
        ctx!.clip();

        // Lens interior background tint
        ctx!.fillStyle = isDark ? 'rgba(6, 10, 20, 0.55)' : 'rgba(250, 248, 243, 0.55)';
        ctx!.fillRect(mouseX - eyepieceRadius, mouseY - eyepieceRadius, eyepieceRadius * 2, eyepieceRadius * 2);

        // Inside the eyepiece: reveal raw noise fluctuations
        ctx!.fillStyle = isDark ? 'rgba(245, 158, 11, 0.7)' : 'rgba(217, 119, 6, 0.8)';
        for (let i = 0; i < 18; i++) {
          const angle = (i / 18) * Math.PI * 2 + tick * 0.05;
          const dist = 10 + (i % 4) * 8;
          const nx = mouseX + Math.cos(angle) * dist;
          const ny = mouseY + Math.sin(angle) * dist;
          ctx!.fillRect(nx - 1, ny - 1, 2, 2);
        }
        ctx!.restore();

        // Lens metallic outer rim
        ctx!.strokeStyle = cyan;
        ctx!.lineWidth = 1.2;
        ctx!.beginPath();
        ctx!.arc(mouseX, mouseY, eyepieceRadius, 0, Math.PI * 2);
        ctx!.stroke();

        // Eyepiece Reticle Tag
        ctx!.fillStyle = cyan;
        ctx!.font = '8px "JetBrains Mono", monospace';
        ctx!.fillText('EYEPIECE: RAW SENSOR APERTURE', mouseX - 55, mouseY - eyepieceRadius - 6);
      }

      tick++;
      if (isComponentVisible && !prefersReducedMotion) {
        animationId = requestAnimationFrame(render);
      } else {
        animationId = 0;
      }
    }

    // Pause rendering when offscreen or document is hidden
    let isComponentVisible = true;
    const plateContainer = document.getElementById('physics-instrument-container');
    let observer: IntersectionObserver | null = null;
    if (plateContainer && 'IntersectionObserver' in window) {
      observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          isComponentVisible = entry.isIntersecting;
          if (isComponentVisible && !animationId && !prefersReducedMotion) {
            animationId = requestAnimationFrame(render);
          }
        });
      }, { threshold: 0.05 });
      observer.observe(plateContainer);
    }

    function onVisibility() {
      if (document.hidden) {
        isComponentVisible = false;
      } else {
        isComponentVisible = true;
        if (!animationId && !prefersReducedMotion) animationId = requestAnimationFrame(render);
      }
    }
    document.addEventListener('visibilitychange', onVisibility);

    
    // Listen for theme toggle changes so canvas redraws instantly
    const themeObserver = new MutationObserver(() => {
      syncModeUI();
      if (!animationId && isComponentVisible && !prefersReducedMotion) {
        render();
      }
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme']
    });

    syncModeUI();
    render();

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationId);
      window.removeEventListener('resize', resize);
      document.removeEventListener('visibilitychange', onVisibility);
      observer?.disconnect();
      themeObserver.disconnect();
    }, { once: true });
  }

  initAdvancedPhysicsPlate();
  document.addEventListener('astro:page-load', initAdvancedPhysicsPlate);
</script>
