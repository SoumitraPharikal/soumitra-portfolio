    color: #FFFFFF !important;
    border-color: #D97706 !important;
    font-weight: 700 !important;
    box-shadow: 0 2px 8px rgba(217, 119, 6, 0.35) !important;
  }

  :global(html[data-theme="light"]) .mode-pill.is-active .mode-number {
    color: #FEF3C7 !important;
  }

  :global(html[data-theme="light"]) .mini-control-btn {
    background: #FFFFFF !important;
    border: 1px solid #CBD5E1 !important;
    color: #D97706 !important;
  }

  :global(html[data-theme="light"]) .mini-control-btn:hover {
    background: #F8FAFC !important;
    border-color: #D97706 !important;
    box-shadow: 0 2px 6px rgba(217, 119, 6, 0.2) !important;
  }

  :global(html[data-theme="light"]) .coord-tag {
    color: #475569 !important;
  }

  :global(html[data-theme="light"]) .drag-3d-hint-pill {
    background: rgba(255, 255, 255, 0.9) !important;
    border: 1px solid rgba(217, 119, 6, 0.4) !important;
    color: #D97706 !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08) !important;
  }

  /* Aceternity / Componentry Perimeter Border Beam */
  .border-beam-card {
    position: relative;
  }
  .border-beam-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(from var(--beam-angle, 0deg) at 50% 50%, transparent 0%, transparent 70%, rgba(229, 169, 60, 0.65) 88%, transparent 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    animation: borderBeamOrbit 9s linear infinite;
    opacity: 0.75;
    z-index: 3;
  }
  @property --beam-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  @keyframes borderBeamOrbit {
    from { --beam-angle: 0deg; }
    to { --beam-angle: 360deg; }
  }

  /* Cult-UI Tactile Slider */
  .tactile-range-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
  }
  .tactile-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    outline: none;
    cursor: grab;
    transition: background 0.15s ease;
  }
  .tactile-slider:active {
    cursor: grabbing;
  }
  .tactile-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--accent-primary);
    box-shadow: 0 0 10px rgba(229, 169, 60, 0.7);
    border: 2px solid #0B0F17;
    cursor: grab;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .tactile-slider::-webkit-slider-thumb:hover {
    transform: scale(1.25);
    box-shadow: 0 0 14px rgba(229, 169, 60, 0.9);
  }
  .tactile-slider::-moz-range-thumb {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--accent-primary);
    box-shadow: 0 0 10px rgba(229, 169, 60, 0.7);
    border: 2px solid #0B0F17;
    cursor: grab;
  }

  /* MotionSites.ai Smooth Transition State */
  .mode-anim-element {
    transition: opacity 180ms cubic-bezier(0.22, 1, 0.36, 1), transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mode-anim-fade {
    opacity: 0 !important;
    transform: translateY(3px) !important;
  }

  .drag-3d-hint-pill {
    position: absolute;
    top: 10px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    background: rgba(11, 15, 23, 0.85);
    border: 1px solid rgba(229, 169, 60, 0.35);
    color: var(--accent-primary);
    border-radius: 4px;
    pointer-events: none;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }
  .drag-hint-icon {
    font-size: 0.75rem;
    color: var(--accent-secondary);
  }
  .pulse-amber-border {
    animation: pulseAmberBorder 1.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes pulseAmberBorder {
    0% { border-color: var(--accent-primary); box-shadow: 0 0 0 3px rgba(229, 169, 60, 0.4), 0 0 20px rgba(229, 169, 60, 0.3); }
    100% { border-color: var(--border-subtle); box-shadow: none; }
  }

</style>

<script>
  function initAdvancedPhysicsPlate() {
    const canvas = document.getElementById('physics-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const drag3dHint = document.getElementById('drag-3d-hint');

    // 3D Canvas Drag Interaction
    canvas.addEventListener('mousedown', (e: MouseEvent) => {
      if (currentMode === 'nbody') {
        isDragging3D = true;
        lastDragX = e.clientX;
        lastDragY = e.clientY;
        canvas.style.cursor = 'grabbing';
      }
    });

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (isDragging3D) {
        const dx = e.clientX - lastDragX;
        const dy = e.clientY - lastDragY;
        yaw3D += dx * 0.012;
        pitch3D = Math.max(0.18, Math.min(1.25, pitch3D + dy * 0.012));
        lastDragX = e.clientX;
        lastDragY = e.clientY;
      }
    });

    window.addEventListener('mouseup', () => {
      if (isDragging3D) {
        isDragging3D = false;
        if (canvas) canvas.style.cursor = (currentMode === 'nbody') ? 'grab' : 'crosshair';
      }
    });

    canvas.addEventListener('touchstart', (e: TouchEvent) => {
      if (currentMode === 'nbody' && e.touches.length === 1) {
        isDragging3D = true;
        lastDragX = e.touches[0].clientX;
        lastDragY = e.touches[0].clientY;
      }
    }, { passive: true });

    window.addEventListener('touchmove', (e: TouchEvent) => {
      if (isDragging3D && e.touches.length === 1) {
