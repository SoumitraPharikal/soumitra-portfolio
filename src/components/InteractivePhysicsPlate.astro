    transition: transform 100ms ease;
  }

  .fine-range::-webkit-slider-thumb:hover {
    transform: scale(1.25);
  }

  .fine-range::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent-primary);
    border: 2px solid #06080E;
    box-shadow: 0 0 6px var(--accent-primary);
    cursor: pointer;
  }

  .fine-readout {
    font-size: 0.75rem;
    color: var(--accent-gold);
    white-space: nowrap;
    min-width: 100px;
  }

  .metrics-group {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .plate-metric-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-surface-sunken);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .metric-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .dot-cyan {
