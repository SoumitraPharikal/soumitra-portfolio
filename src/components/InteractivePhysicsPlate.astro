  }

  :global(html[data-theme="light"]) .status-indicator-pill {
    background: #EFECE6 !important;
    border: 1px solid #E2E8F0 !important;
    color: #475569 !important;
  }

  :global(html[data-theme="light"]) .plate-caption-strip {
    background: #EFECE6 !important;
    border-color: #E2E8F0 !important;
    color: #475569 !important;
  }

  :global(html[data-theme="light"]) .canvas-viewport {
    background: #F8F7F2 !important;
  }

  :global(html[data-theme="light"]) .fine-label,
  :global(html[data-theme="light"]) .mono-label {
