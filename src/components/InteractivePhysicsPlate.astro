    font-size: 0.75rem !important;
  }

  :global(html[data-theme="light"]) .fine-readout {
    color: #D97706 !important;
    font-size: 0.75rem !important;
  }

  :global(html[data-theme="light"]) .plate-metric-badge {
    background: #EFECE6 !important;
    border: 1px solid #E2E8F0 !important;
    color: #14181F !important;
  }

  :global(html[data-theme="light"]) .tactile-slider {
    background: #E2E8F0 !important;
  }

  :global(html[data-theme="light"]) .tactile-slider::-webkit-slider-thumb {
