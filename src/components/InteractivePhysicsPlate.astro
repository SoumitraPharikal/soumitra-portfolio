  }

  .coord-tl { top: 8px; left: 12px; }
  .coord-tr { top: 8px; right: 12px; }

  /* Single-Line Footer */
  .plate-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px var(--space-4);
    background-color: var(--bg-surface-elevated);
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .slider-control-group {
