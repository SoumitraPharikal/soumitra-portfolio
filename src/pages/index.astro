<script>
  // Hero Typewriter Engine
  function initHeroTypewriter() {
    const target = document.getElementById('hero-typewriter');
    if (!target) return;

    const phrases = [
      "computational astrophysics & numerical modeling.",
      "Rust astrodynamics & orbital simulation.",
      "CCD photometry & variable star discovery.",
      "optical wavefronts & Zernike decomposition.",
      "tomographic inversion & inverse problems."
    ];

    let phraseIdx = 0;
    const el = target as HTMLElement;
    let charIdx = phrases[0].length;
    let isDeleting = true;
    let timer: number = 0;

    function tick() {
      const current = phrases[phraseIdx];
      if (isDeleting) {
        charIdx--;
        el.textContent = current.substring(0, charIdx);
        if (charIdx <= 0) {
          isDeleting = false;
          phraseIdx = (phraseIdx + 1) % phrases.length;
          timer = window.setTimeout(tick, 400);
          return;
        }
        timer = window.setTimeout(tick, 35);
      } else {
        charIdx++;
        el.textContent = current.substring(0, charIdx);
        if (charIdx >= current.length) {
          isDeleting = true;
          timer = window.setTimeout(tick, 1800); // Hold for 1.8s
          return;
        }
        timer = window.setTimeout(tick, 60);
      }
    }

    timer = window.setTimeout(tick, 2500);

    document.addEventListener('astro:before-swap', () => {
      clearTimeout(timer);
    }, { once: true });
  }

  initHeroTypewriter();
  document.addEventListener('astro:page-load', initHeroTypewriter);
</script>

