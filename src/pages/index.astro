        <p class="section-subtitle reading-measure text-secondary">
          Four flagship scientific computing and observational astrophysics projects with complete physical models, numerical algorithms, and reproducible pipelines.
        </p>
      </div>

      <!-- 2x2 Bento Grid -->
      <div class="monographs-bento-grid reveal-up" style="--stagger-index: 2;">
        <!-- Card 1: IC 1369 Photometry -->
