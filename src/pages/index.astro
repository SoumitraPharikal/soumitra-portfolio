            <a href="/projects/zernike-wavefront-analyzer" class="editorial-btn">
              View Project <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      </div>
    </section>

    <div class="haikei-wave-divider reveal-line" style="--stagger-index: 1;" aria-hidden="true">
      <svg viewBox="0 0 1200 48" preserveAspectRatio="none">
