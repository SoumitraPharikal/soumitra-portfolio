---
import BaseLayout from '../layouts/BaseLayout.astro';
import InteractivePhysicsPlate from '../components/InteractivePhysicsPlate.astro';
import katex from 'katex';

// Pre-render KaTeX Equations in frontmatter for zero-FOUC static HTML
const eqDomainAstro = katex.renderToString(
  'P_{\\text{LS}}(\\omega) = \\frac{1}{2\\sigma^2}\\left[\\frac{C^2}{C_0} + \\frac{S^2}{S_0}\\right]',
  { displayMode: true, throwOnError: false }
);

const eqDomainAstrodynamics = katex.renderToString(
  '\\ddot{\\mathbf{r}}_i = -G \\sum_{j \\ne i} \\frac{m_j(\\mathbf{r}_i - \\mathbf{r}_j)}{|\\mathbf{r}_i - \\mathbf{r}_j|^3} + \\mathbf{a}_{J_2}',
  { displayMode: true, throwOnError: false }
);

const eqDomainComputational = katex.renderToString(
  '\\mathcal{R}f(s,\\theta) = \\int_{\\mathbb{R}^2} f(\\mathbf{r})\\,\\delta(\\mathbf{r}\\cdot\\hat{\\mathbf{n}}_\\theta - s)\\,d^2\\mathbf{r}',
  { displayMode: true, throwOnError: false }
);

---

<BaseLayout
  title="Soumitra Pharikal | Academic Research & Computational Portfolio"
  description="Personal academic and research portfolio of Soumitra Pharikal (IISER Berhampur). Observational astrophysics, orbital mechanics, optical wavefront analysis, and computational physics."
>
  <div class="monograph-container">

    <!-- ====================================================================
         SECTION 00: EDITORIAL HERO
         ==================================================================== -->
    <section class="hero-section" aria-label="Introduction & Academic Overview">
      <!-- Haikei Generative Isochrone & Gravitational Potential Contour Mesh -->
      <div class="haikei-contour-mesh" aria-hidden="true">
        <svg viewBox="0 0 1000 600" fill="none" preserveAspectRatio="none">
          <path d="M-50,150 C200,80 400,280 1050,120" stroke="currentColor" stroke-width="1" />
          <path d="M-50,220 C250,160 500,360 1050,190" stroke="currentColor" stroke-width="1" stroke-dasharray="6 4" />
          <path d="M-50,300 C300,240 600,440 1050,270" stroke="currentColor" stroke-width="1" />
          <path d="M-50,390 C350,320 700,520 1050,360" stroke="currentColor" stroke-width="1" stroke-dasharray="8 6" />
          <ellipse cx="580" cy="340" rx="220" ry="120" stroke="currentColor" stroke-width="0.8" />
          <ellipse cx="580" cy="340" rx="360" ry="200" stroke="currentColor" stroke-width="0.8" stroke-dasharray="4 6" />
          <ellipse cx="580" cy="340" rx="500" ry="280" stroke="currentColor" stroke-width="0.6" />
        </svg>
      </div>
      <div class="swiss-grid-12 hero-grid">
        <!-- Columns 1–6: Narrative & Identity -->
        <div class="col-6 hero-narrative reveal-up" style="--stagger-index: 1;">
          <div class="hero-glass-plate border-beam-card">
            <div class="hero-eyebrow">
              <span class="pulse-dot" aria-hidden="true"></span>
              <span class="mono-badge">BS-MS PHYSICS &amp; CDS · IISER BERHAMPUR</span>
            </div>

            <h1 class="hero-headline">
              Exploring physical systems through<br />
              <span class="hero-typewriter-wrap typewriter-container"><span id="hero-typewriter" class="typewriter-text">stellar CCD photometry.</span><span class="typewriter-cursor" aria-hidden="true">|</span></span>
            </h1>

            <div class="hero-prose reading-measure">
              <p class="lead">
                Hi, I'm Soumitra, a third-year BS-MS student at IISER Berhampur majoring in Physics with a minor in Computational and Data Sciences. I develop Rust-based astrodynamics and orbital propagation toolkits (ASTRA), build observational CCD photometry pipelines for variable star discovery, and model optical wavefront aberrations and inverse problems.
              </p>
            </div>

            <!-- Action Bar & Quick Links -->
            <div class="hero-actions">
              <a href="/research" class="editorial-btn primary">
                Explore Research &amp; Projects <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/projects" class="editorial-btn">
                Inspect Code &amp; Projects <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
            </div>

            <div class="hero-meta-strip hairline-top">
              <div class="meta-item">
                <span class="meta-index">CURRICULUM</span>
                <a href="/cv" class="editorial-link">Curriculum Vitae (CV) ↗</a>
              </div>
              <div class="meta-item">
                <span class="meta-index">COURSE NOTES</span>
                <a href="/writing" class="editorial-link">LaTeX Course Notes ↗</a>
              </div>
              <div class="meta-item">
                <span class="meta-index">STATION</span>
                <span class="mono-text">Berhampur, Odisha [19.200° N, 84.835° E]</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Columns 7–12: Interactive Physics Instrument -->
        <div class="col-6 hero-instrument no-tilt reveal-up" style="--stagger-index: 3;">
          <InteractivePhysicsPlate />
        </div>
      </div>
    </section>

    <div class="haikei-wave-divider reveal-line" style="--stagger-index: 2;" aria-hidden="true">
      <svg viewBox="0 0 1200 48" preserveAspectRatio="none">
        <defs>
          <linearGradient id="waveH1" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#00F0FF" stop-opacity="0.35" />
            <stop offset="50%" stop-color="#3B82F6" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#A855F7" stop-opacity="0.4" />
          </linearGradient>
          <linearGradient id="waveH2" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#10B981" stop-opacity="0.2" />
          </linearGradient>
        </defs>
        <path d="M0,24 C200,8 400,38 600,18 C800,2 1000,38 1200,20 L1200,48 L0,48 Z" fill="url(#waveH1)"></path>
        <path d="M0,32 C250,44 500,16 750,34 C950,48 1100,24 1200,30 L1200,48 L0,48 Z" fill="url(#waveH2)"></path>
      </svg>
    </div>

    <!-- ====================================================================
         SECTION 01: RESEARCH ARCHITECTURE & INTELLECTUAL FOCUS
         ==================================================================== -->
    <section class="section-container" id="domains-section" aria-label="Research Domains">
      <div class="section-header-block reveal-up" style="--stagger-index: 1;">
        <span class="meta-index">§ 01 / RESEARCH FOCUS</span>
        <h2 class="section-title">Core Investigative Domains</h2>
        <p class="section-subtitle reading-measure text-secondary">
          Bridging empirical observational reduction pipelines, high-performance astrodynamics simulation, and inverse mathematical physics.
        </p>
      </div>

      <div class="swiss-grid-12 domains-grid">
        <!-- 01 // ASTROPHYSICS -->
        <div class="col-4 domain-card hairline-box spotlight-card interactive-row corner-crosshair reveal-up" style="--stagger-index: 2;">
          <div class="domain-header">
            <span class="domain-code mono">01 // ASTROPHYSICS</span>
            <span class="domain-period mono">OBSERVATIONAL ASTRONOMY</span>
          </div>
          <h3 class="domain-title">Variable Star Photometry &amp; Exoplanetary Transits</h3>
          <p class="domain-desc text-secondary">
            Time-domain stellar variability analysis, point-spread-function (PSF) crowded-field deblending, non-parametric periodogram power spectra, and PARSEC theoretical isochrone CMD fitting.
          </p>
          <div class="domain-math-box">
            <div set:html={eqDomainAstro} />
          </div>
          <div class="domain-footer hairline-top">
            <div class="pipeline-chips-wrap">
              <span class="meta-index pipeline-label">PIPELINE:</span>
              <div class="pipeline-chips">
                <span class="pipeline-chip mono" style="--chip-index: 0;">PYTHON</span>
                <span class="pipeline-chip mono" style="--chip-index: 1;">ASTROPY</span>
                <span class="pipeline-chip mono" style="--chip-index: 2;">PHOTUTILS</span>
                <span class="pipeline-chip mono" style="--chip-index: 3;">DAOPHOT II</span>
                <span class="pipeline-chip mono" style="--chip-index: 4;">PARSEC</span>
              </div>
            </div>
            <div class="domain-actions-group">
              <button type="button" class="load-in-lab-btn mono" data-sim-mode="1" title="Load IC 1369 Light Curve in Interactive Physics Lab">Load in Lab ↑</button>
              <a href="/research#ic1369" class="domain-link">View Research Record →</a>
            </div>
          </div>
        </div>

        <!-- 02 // ASTRODYNAMICS & SIMULATION -->
        <div class="col-4 domain-card hairline-box spotlight-card interactive-row corner-crosshair reveal-up" style="--stagger-index: 3;">
          <div class="domain-header">
            <span class="domain-code mono">02 // ASTRODYNAMICS</span>
            <span class="domain-period mono">HIGH-PERFORMANCE COMPUTE</span>
          </div>
          <h3 class="domain-title">ASTRA: Orbital Propagation &amp; Symplectic Solvers</h3>
          <p class="domain-desc text-secondary">
            Hamiltonian N-body gravitational dynamics, canonical symplectic phase-space integration, zonal harmonic J₂ oblateness perturbations, and satellite TLE propagation.
          </p>
          <div class="domain-math-box">
            <div set:html={eqDomainAstrodynamics} />
          </div>
          <div class="domain-footer hairline-top">
            <div class="pipeline-chips-wrap">
              <span class="meta-index pipeline-label">PIPELINE:</span>
              <div class="pipeline-chips">
                <span class="pipeline-chip mono" style="--chip-index: 0;">RUST</span>
                <span class="pipeline-chip mono" style="--chip-index: 1;">SIMD</span>
                <span class="pipeline-chip mono" style="--chip-index: 2;">YOSHIDA SYMPLECTIC</span>
                <span class="pipeline-chip mono" style="--chip-index: 3;">DOP853</span>
                <span class="pipeline-chip mono" style="--chip-index: 4;">SGP4</span>
              </div>
            </div>
            <div class="domain-actions-group">
              <button type="button" class="load-in-lab-btn mono" data-sim-mode="2" title="Load N-Body Dynamics in Interactive Physics Lab">Load in Lab ↑</button>
              <a href="/projects/astra-rust-toolkit" class="domain-link">View ASTRA Project →</a>
            </div>
          </div>
        </div>

        <!-- 03 // COMPUTATIONAL PHYSICS & OPTICS -->
        <div class="col-4 domain-card hairline-box spotlight-card interactive-row corner-crosshair reveal-up" style="--stagger-index: 4;">
          <div class="domain-header">
            <span class="domain-code mono">03 // INVERSE PHYSICS</span>
            <span class="domain-period mono">TOMOGRAPHY &amp; WAVEFRONTS</span>
          </div>
          <h3 class="domain-title">Tomographic Inversion &amp; Wavefront Sensing</h3>
          <p class="domain-desc text-secondary">
            Ill-posed linear inverse problems, Fourier-slice tomographic sinogram reconstruction, and orthogonal Zernike polynomial wavefront aberration modeling.
          </p>
          <div class="domain-math-box">
            <div set:html={eqDomainComputational} />
          </div>
          <div class="domain-footer hairline-top">
            <div class="pipeline-chips-wrap">
              <span class="meta-index pipeline-label">PIPELINE:</span>
              <div class="pipeline-chips">
                <span class="pipeline-chip mono" style="--chip-index: 0;">NUMPY</span>
                <span class="pipeline-chip mono" style="--chip-index: 1;">SCIPY</span>
                <span class="pipeline-chip mono" style="--chip-index: 2;">SKIMAGE</span>
                <span class="pipeline-chip mono" style="--chip-index: 3;">MATLAB</span>
                <span class="pipeline-chip mono" style="--chip-index: 4;">ZERNIKE MODES</span>
              </div>
            </div>
            <div class="domain-actions-group">
              <button type="button" class="load-in-lab-btn mono" data-sim-mode="3" title="Load Radon Transform in Interactive Physics Lab">Load in Lab ↑</button>
              <a href="/projects/ct-imaging-tumour-detection" class="domain-link">View Inversion Project →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="haikei-wave-divider reveal-line" style="--stagger-index: 1;" aria-hidden="true">
      <svg viewBox="0 0 1200 48" preserveAspectRatio="none">
        <defs>
          <linearGradient id="waveH3" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#10B981" stop-opacity="0.3" />
            <stop offset="50%" stop-color="#00F0FF" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#6366F1" stop-opacity="0.35" />
          </linearGradient>
          <linearGradient id="waveH4" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#A855F7" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#F43F5E" stop-opacity="0.2" />
          </linearGradient>
        </defs>
        <path d="M0,20 C220,38 450,10 700,28 C920,44 1080,18 1200,26 L1200,48 L0,48 Z" fill="url(#waveH3)"></path>
        <path d="M0,30 C280,16 540,42 800,22 C1020,8 1120,32 1200,28 L1200,48 L0,48 Z" fill="url(#waveH4)"></path>
      </svg>
    </div>

    <!-- ====================================================================
         SECTION 02: 2x2 BENTO GRID: 4 FEATURED TECHNICAL PROJECTS
         ==================================================================== -->
    <section class="section-container" id="projects-section" aria-label="Featured Technical Projects">
      <div class="section-header-block reveal-up" style="--stagger-index: 1;">
        <span class="meta-index">§ 02 / SELECTED PROJECTS</span>
        <h2 class="section-title">Featured Research &amp; Computational Projects</h2>
        <p class="section-subtitle reading-measure text-secondary">
          Five flagship scientific computing and observational astrophysics projects with complete physical models, numerical algorithms, and reproducible pipelines.
        </p>
      </div>

      <!-- 2x2 Bento Grid -->
      <div class="monographs-bento-grid reveal-up" style="--stagger-index: 2;">
        <!-- Card 1: IC 1369 Photometry (Bento 7-Col) -->
        <article class="bento-card col-bento-7 hairline-box spotlight-card interactive-row corner-crosshair border-beam-card">
          <div class="bento-card-header">
            <div class="bento-tags mono">
              <span class="bento-num text-signal">01</span>
              <span class="bento-domain">OBSERVATIONAL ASTROPHYSICS</span>
            </div>
            <div class="bento-header-right">
              <div class="bento-sparkline-wrap" title="Phase-Folded Eclipsing Binary Light Curve Dip">
                <img src="/thumbnails/projects/ic1369.png" alt="Variable Star Photometry &amp; Isochronal Age of IC 1369" class="bento-custom-thumb" loading="lazy" onerror="this.style.display='none'; if (this.nextElementSibling) this.nextElementSibling.style.display='block';" />
                <svg class="bento-sparkline" viewBox="0 0 96 40" width="96" height="40" aria-hidden="true">
                  <path d="M 4 12 L 26 12 Q 36 12 42 28 Q 48 35 54 28 Q 60 12 70 12 L 92 12" fill="none" stroke="var(--accent-primary)" stroke-width="1.8" stroke-linecap="round" />
                  <circle cx="48" cy="33" r="2.5" fill="var(--accent-secondary)" />
                </svg>
              </div>
              <span class="bento-period mono text-tertiary">ICSP KOLKATA · 2026</span>
            </div>
          </div>

          <h3 class="bento-card-title">
            <a href="/projects/ic-1369-photometry-pipeline" class="title-link no-underline">
              Variable Star Photometry &amp; Isochronal Age of IC 1369
            </a>
          </h3>

          <p class="bento-card-desc text-secondary">
            Reduction of 814 time-series CCD frames using DAOPHOT point-spread-function extraction, 
            Lomb-Scargle periodograms, and PARSEC isochrone CMD fitting for open cluster IC 1369.
          </p>

          <div class="quant-result-strip mono">
            <span class="quant-chip"><span class="quant-dot dot-cyan"></span>814 CCD Frames</span>
            <span class="quant-chip"><span class="quant-dot dot-gold"></span>P = 1.4820 d</span>
            <span class="quant-chip"><span class="quant-dot dot-amber"></span>σ_phot ≤ 0.014 mag</span>
          </div>

          <div class="bento-card-footer hairline-top">
            <div class="pipeline-chips">
              <span class="pipeline-chip mono" style="--chip-index: 0;">PYTHON</span>
              <span class="pipeline-chip mono" style="--chip-index: 1;">ASTROPY</span>
              <span class="pipeline-chip mono" style="--chip-index: 2;">DAOPHOT</span>
              <span class="pipeline-chip mono" style="--chip-index: 3;">PARSEC</span>
            </div>
            <div class="bento-cta-group">
              <button type="button" class="load-in-lab-btn mono" data-sim-mode="1" title="Load IC 1369 Light Curve in Interactive Physics Lab">Load in Lab ↑</button>
              <a href="/projects/ic-1369-photometry-pipeline" class="editorial-btn">
                View Project <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Card 2: ASTRA Rust Toolkit (Bento 5-Col) -->
        <article class="bento-card col-bento-5 hairline-box spotlight-card interactive-row corner-crosshair">
          <div class="bento-card-header">
            <div class="bento-tags mono">
              <span class="bento-num text-signal">02</span>
              <span class="bento-domain">ASTRODYNAMICS &amp; SIMULATION</span>
            </div>
            <div class="bento-header-right">
              <div class="bento-sparkline-wrap" title="Precessing Elliptical Keplerian Orbits">
                <img src="/thumbnails/projects/astra.png" alt="ASTRA: High-Performance Rust Astrodynamics Toolkit" class="bento-custom-thumb" loading="lazy" onerror="this.style.display='none'; if (this.nextElementSibling) this.nextElementSibling.style.display='block';" />
                <svg class="bento-sparkline" viewBox="0 0 96 40" width="96" height="40" aria-hidden="true">
                  <ellipse cx="48" cy="20" rx="36" ry="14" fill="none" stroke="var(--accent-primary)" stroke-width="1.5" transform="rotate(-15 48 20)" opacity="0.85" />
                  <ellipse cx="48" cy="20" rx="26" ry="9" fill="none" stroke="var(--accent-primary)" stroke-width="1.2" stroke-dasharray="2 3" transform="rotate(18 48 20)" opacity="0.6" />
                  <circle cx="48" cy="20" r="2.5" fill="var(--accent-primary)" />
                  <circle cx="20" cy="14" r="2" fill="var(--accent-secondary)" />
                </svg>
              </div>
              <span class="bento-period mono text-tertiary">RUST ENGINE · 2026</span>
            </div>
          </div>

          <h3 class="bento-card-title">
            <a href="/projects/astra-rust-toolkit" class="title-link no-underline">
              ASTRA: High-Performance Rust Astrodynamics Toolkit
            </a>
          </h3>

          <p class="bento-card-desc text-secondary">
            Deterministic N-body orbital propagation using Yoshida symplectic integrators preserving Hamiltonian energy to ΔE/E₀ &lt; 10⁻¹² over 10⁶ steps, J₂ oblateness perturbations, and SGP4 propagation.
          </p>

          <div class="quant-result-strip mono">
            <span class="quant-chip"><span class="quant-dot dot-cyan"></span>ΔE/E₀ &lt; 10⁻¹²</span>
            <span class="quant-chip"><span class="quant-dot dot-gold"></span>10⁶ Steps</span>
            <span class="quant-chip"><span class="quant-dot dot-amber"></span>Yoshida 6th-Order</span>
          </div>

          <div class="bento-card-footer hairline-top">
            <div class="pipeline-chips">
              <span class="pipeline-chip mono" style="--chip-index: 0;">RUST</span>
              <span class="pipeline-chip mono" style="--chip-index: 1;">SIMD</span>
              <span class="pipeline-chip mono" style="--chip-index: 2;">YOSHIDA</span>
              <span class="pipeline-chip mono" style="--chip-index: 3;">SGP4</span>
            </div>
            <div class="bento-cta-group">
              <button type="button" class="load-in-lab-btn mono" data-sim-mode="2" title="Load ASTRA N-Body Dynamics in Interactive Physics Lab">Load in Lab ↑</button>
              <a href="/projects/astra-rust-toolkit" class="editorial-btn">
                View Project <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Card 3: Radon CT Tumour Detection (Bento 5-Col) -->
        <article class="bento-card col-bento-5 hairline-box spotlight-card interactive-row corner-crosshair">
          <div class="bento-card-header">
            <div class="bento-tags mono">
              <span class="bento-num text-signal">03</span>
              <span class="bento-domain">COMPUTATIONAL TOMOGRAPHY</span>
            </div>
            <div class="bento-header-right">
              <div class="bento-sparkline-wrap" title="Radon Sinogram Inversion Rays">
                <img src="/thumbnails/projects/radon-ct.png" alt="Physics-Informed Synthetic CT Reconstruction &amp; Lesion Classification" class="bento-custom-thumb" loading="lazy" onerror="this.style.display='none'; if (this.nextElementSibling) this.nextElementSibling.style.display='block';" />
                <svg class="bento-sparkline" viewBox="0 0 96 40" width="96" height="40" aria-hidden="true">
                  <circle cx="48" cy="20" r="14" fill="none" stroke="var(--accent-primary)" stroke-width="1.3" opacity="0.5" stroke-dasharray="3 2" />
                  <ellipse cx="48" cy="20" rx="6" ry="4" fill="var(--accent-primary)" opacity="0.3" />
                  <line x1="12" y1="8" x2="84" y2="32" stroke="var(--accent-secondary)" stroke-width="1.2" opacity="0.85" />
                  <line x1="12" y1="32" x2="84" y2="8" stroke="var(--accent-primary)" stroke-width="1.2" opacity="0.85" />
                  <line x1="48" y1="4" x2="48" y2="36" stroke="var(--accent-primary)" stroke-width="1" stroke-dasharray="2 2" opacity="0.5" />
                </svg>
              </div>
              <span class="bento-period mono text-tertiary">ALGEBRAIC INVERSION · 2025</span>
            </div>
          </div>

          <h3 class="bento-card-title">
            <a href="/projects/ct-imaging-tumour-detection" class="title-link no-underline">
              Physics-Informed Synthetic CT Reconstruction &amp; Lesion Classification
            </a>
          </h3>

          <p class="bento-card-desc text-secondary">
            Continuous Radon projection transforms, 2D slice-wise Filtered Back-Projection (FBP) with Ram-Lak ramp frequency filtering, 
            and Hounsfield Unit neoplasm segmentation on synthetic Shepp-Logan phantoms.
          </p>

          <div class="quant-result-strip mono">
            <span class="quant-chip"><span class="quant-dot dot-cyan"></span>180° Sinogram Sweep</span>
            <span class="quant-chip"><span class="quant-dot dot-gold"></span>Ram-Lak FBP</span>
            <span class="quant-chip"><span class="quant-dot dot-amber"></span>HU Segmentation</span>
          </div>

          <div class="bento-card-footer hairline-top">
            <div class="pipeline-chips">
              <span class="pipeline-chip mono" style="--chip-index: 0;">NUMPY</span>
              <span class="pipeline-chip mono" style="--chip-index: 1;">SCIPY</span>
              <span class="pipeline-chip mono" style="--chip-index: 2;">SKIMAGE</span>
              <span class="pipeline-chip mono" style="--chip-index: 3;">RADON FBP</span>
            </div>
            <div class="bento-cta-group">
              <button type="button" class="load-in-lab-btn mono" data-sim-mode="3" title="Load Radon Reconstruction in Interactive Physics Lab">Load in Lab ↑</button>
              <a href="/projects/ct-imaging-tumour-detection" class="editorial-btn">
                View Project <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Card 4: Zernike Wavefront Analyzer (Bento 7-Col) -->
        <article class="bento-card col-bento-7 hairline-box spotlight-card interactive-row corner-crosshair">
          <div class="bento-card-header">
            <div class="bento-tags mono">
              <span class="bento-num text-signal">04</span>
              <span class="bento-domain">ADAPTIVE OPTICS</span>
            </div>
            <div class="bento-header-right">
              <div class="bento-sparkline-wrap" title="Zernike Circular Pupil Aberration Rings">
                <img src="/thumbnails/projects/zernike.png" alt="Zernike Polynomial Wavefront Decomposition &amp; Modal Analysis" class="bento-custom-thumb" loading="lazy" onerror="this.style.display='none'; if (this.nextElementSibling) this.nextElementSibling.style.display='block';" />
