<script>
  // Hero Typewriter Engine
  function initHeroTypewriter() {
    const target = document.getElementById('hero-typewriter');
    if (!target) return;

    const phrases = [
      "stellar CCD photometry.",
      "symplectic N-body solvers.",
      "optical wavefront models.",
      "tomographic inversions.",
      "quantum wave-packet FFTs."
    ];

    let phraseIdx = 0;
    const el = target as HTMLElement;
    let charIdx = phrases[0].length;
    let isDeleting = true;
    let timer: number = 0;

    function tick() {
      const current = phrases[phraseIdx];
      if (isDeleting) {
        charIdx--;
        el.textContent = current.substring(0, charIdx);
        if (charIdx <= 0) {
          isDeleting = false;
          phraseIdx = (phraseIdx + 1) % phrases.length;
          timer = window.setTimeout(tick, 400);
          return;
        }
        timer = window.setTimeout(tick, 35);
      } else {
        charIdx++;
        el.textContent = current.substring(0, charIdx);
        if (charIdx >= current.length) {
          isDeleting = true;
          timer = window.setTimeout(tick, 1800); // Hold for 1.8s
          return;
        }
        timer = window.setTimeout(tick, 60);
      }
    }

    timer = window.setTimeout(tick, 2500);

    document.addEventListener('astro:before-swap', () => {
      clearTimeout(timer);
    }, { once: true });
  }

  initHeroTypewriter();
  document.addEventListener('astro:page-load', initHeroTypewriter);

  // Synchronized "Load in Lab ↑" Cross-Trigger Engine
  function initLoadInLab() {
    document.querySelectorAll('.load-in-lab-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const mode = (btn as HTMLElement).dataset.simMode;
        const modeKey = mode === '1' ? 'photometry' : mode === '2' ? 'nbody' : mode === '3' ? 'radon' : 'mc';
        const container = document.getElementById('physics-instrument-container');
        if (container) {
          container.scrollIntoView({ behavior: 'smooth', block: 'center' });
          window.dispatchEvent(new CustomEvent('load-physics-mode', { detail: { mode: modeKey } }));
        }
      });
    });
  }
  initLoadInLab();
  document.addEventListener('astro:page-load', initLoadInLab);
</script>

