---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Curriculum Vitae | Soumitra Pharikal"
  description="Official Academic Curriculum Vitae of Soumitra Pharikal. Education at IISER Berhampur, research internships at ICSP Kolkata and UH Manoa, honors, and technical competencies."
>
  <div class="monograph-container">
    <!-- Header with Prominent Download Button -->
    <header class="cv-header reveal-up" style="--stagger-index: 1;">
      <div class="cv-header-top">
        <div class="cv-meta-strip">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span class="meta-index">CURRICULUM VITAE</span>
        </div>
        <a
          href="/Soumitra_Pharikal_CV.pdf"
          download="Soumitra_Pharikal_CV.pdf"
          class="editorial-btn primary cv-download-btn"
        >
          Download CV (PDF) ↓
        </a>
      </div>

      <div class="cv-identity-block hairline-bottom">
        <div class="cv-identity-header">
          <img
            src="/logos/iiserbpr.png"
            onerror="this.onerror=null; this.src='/logos/iiserbpr-crest.svg';"
            alt="IISER Berhampur Emblem"
            class="cv-inst-emblem"
            width="48"
            height="48"
            loading="lazy"
          />
          <div>
            <h1 class="cv-name">Soumitra Pharikal</h1>
            <p class="cv-subline mono">
              BS-MS Dual Degree Student (Physics Major · Computational and Data Sciences Minor)<br />
              Department of Physical Sciences, IISER Berhampur, Permanent Campus, Laudigam, Konisi, Ganjam, Odisha 760003, India
            </p>
          </div>
        </div>
        <div class="cv-contact-strip mono">
          <span>EMAIL: <a href="mailto:24123@iiserbpr.ac.in">24123@iiserbpr.ac.in</a></span>
          <span>·</span>
          <span>ORCID: <a href="https://orcid.org/0009-0001-8670-0352" target="_blank" rel="noopener noreferrer">0009-0001-8670-0352 ↗</a></span>
          <span>·</span>
          <span>GITHUB: <a href="https://github.com/SoumitraPharikal" target="_blank" rel="noopener noreferrer">github.com/SoumitraPharikal</a></span>
          <span>·</span>
          <span>LINKEDIN: <a href="https://www.linkedin.com/in/soumitra-pharikal" target="_blank" rel="noopener noreferrer">in/soumitra-pharikal</a></span>
        </div>
      </div>
    </header>

    <!-- CV Content Sections -->
    <div class="cv-content-flow">
      <!-- 1. EDUCATION -->
      <section class="cv-section reveal-up" style="--stagger-index: 2;">
        <h2 class="cv-section-title mono text-gold">01 // EDUCATION</h2>
        <div class="cv-entries-list">
          <!-- IISER Berhampur -->
          <div class="cv-entry hairline-box spotlight-card">
            <div class="cv-entry-head">
              <div>
                <h3 class="cv-institution">Indian Institute of Science Education and Research (IISER) Berhampur</h3>
                <p class="cv-degree">BS-MS Dual Degree (Physics Major · Computational and Data Sciences Minor)</p>
              </div>
              <div class="cv-date-col mono">
                <span class="cv-period">SEP 2024 – MAY 2029</span>
                <span class="cv-grade text-gold">CPI: 8.15 / 10.0</span>
              </div>
            </div>
            <p class="cv-notes text-secondary">
              Institute of National Importance under Ministry of Education, Government of India. Coursework in Advanced Classical Mechanics, Quantum Mechanics I, Thermal Physics, Mathematical Methods, and Data Structures.
            </p>
          </div>

          <!-- Puna International School -->
          <div class="cv-entry hairline-box spotlight-card">
            <div class="cv-entry-head">
              <div>
                <h3 class="cv-institution">Puna International School, Gandhinagar / Ahmedabad</h3>
                <p class="cv-degree">Higher Secondary School Certificate (Class XII, CBSE)</p>
              </div>
              <div class="cv-date-col mono">
                <span class="cv-period">COMPLETED 2023</span>
                <span class="cv-grade">Score: 85.0%</span>
              </div>
            </div>
          </div>

          <!-- DPS Ahmedabad -->
          <div class="cv-entry hairline-box spotlight-card">
            <div class="cv-entry-head">
              <div>
                <h3 class="cv-institution">Delhi Public School (DPS), Bopal, Ahmedabad</h3>
                <p class="cv-degree">Secondary School Examination (Class X, CBSE)</p>
              </div>
              <div class="cv-date-col mono">
                <span class="cv-period">COMPLETED 2021</span>
                <span class="cv-grade text-gold">Score: 96.2%</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. HONORS & SCHOLASTIC ACHIEVEMENTS -->
      <section class="cv-section reveal-up" style="--stagger-index: 3;">
        <h2 class="cv-section-title mono text-gold">02 // HONORS &amp; SCHOLASTIC MERIT</h2>
        <div class="cv-awards-table hairline-box spotlight-card mono">
          <div class="award-row">
            <span class="award-year text-secondary">2026</span>
            <div class="award-info">
              <strong class="award-name text-primary">National Graduate Physics Examination (NGPE 2026)</strong>
              <span class="award-sub text-secondary">Rank 1 on the Institute-Wide Merit List at IISER Berhampur (Conducted by IAPT India)</span>
            </div>
          </div>
          <div class="award-row">
            <span class="award-year text-secondary">2022</span>
            <div class="award-info">
              <strong class="award-name text-primary">Indian National Astronomy Olympiad (INAO 2022)</strong>
              <span class="award-sub text-secondary">Qualified for Stage 2 (IOAA selection); placed among Top 256 students nationwide in IOQA 2021–22</span>
            </div>
          </div>
          <div class="award-row">
            <span class="award-year text-secondary">2019 – 2020</span>
            <div class="award-info">
              <strong class="award-name text-primary">Pre-Regional Mathematical Olympiad (PRMO)</strong>
              <span class="award-sub text-secondary">Qualified Stage 1 of International Mathematical Olympiad selection; Top 300 nationwide across Classes 8–12</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. RESEARCH APPOINTMENTS -->
      <section class="cv-section reveal-up" style="--stagger-index: 4;">
        <h2 class="cv-section-title mono text-gold">03 // RESEARCH APPOINTMENTS &amp; INTERNSHIPS</h2>
        <div class="cv-entries-list">
          <!-- ICSP Kolkata -->
          <div class="cv-entry hairline-box spotlight-card">
            <div class="cv-entry-head">
              <div>
                <h3 class="cv-role">Observational Astronomy Research Intern</h3>
                <p class="cv-inst">Indian Centre for Space Physics (ICSP), Kolkata · Advisor: <strong>Dr. Devendra Bisht</strong></p>
              </div>
              <span class="cv-period mono text-secondary">JUN 2026 – AUG 2026</span>
            </div>
            <ul class="cv-bullets text-secondary">
              <li>Reduced and calibrated 814 time-series CCD image frames of Galactic open cluster IC 1369.</li>
              <li>Performed DAOPHOT crowded-field PSF and aperture photometry, correcting for local sky background.</li>
              <li>Executed Generalized Lomb-Scargle periodograms, detecting and characterizing four candidate variable stars (FAP &lt; 10⁻⁶).</li>
              <li>Constructed cluster Color-Magnitude Diagrams (CMD) and fitted PARSEC isochrone grids to estimate cluster age and distance.</li>
            </ul>
          </div>

          <!-- UH Manoa -->
          <div class="cv-entry hairline-box spotlight-card">
            <div class="cv-entry-head">
              <div>
                <h3 class="cv-role">Astronomy Research Trainee (Intro2Astro)</h3>
                <p class="cv-inst">University of Hawaiʻi at Mānoa (Remote) · Program Lead: <strong>Dr. Fei Dai</strong></p>
              </div>
              <span class="cv-period mono text-secondary">JUL 2025 – AUG 2025</span>
            </div>
            <ul class="cv-bullets text-secondary">
              <li>Completed an 8-week research training program analyzing real observation data from TESS, Gaia DR3, and MAST archives.</li>
              <li>Detrended light curves using Python Lightkurve, extracted transit signatures, and calculated exoplanetary radii and orbital periods.</li>
              <li>Remotely attended the 2025 Caltech Sagan Summer Workshop on exoplanet demographics and atmosphere characterization.</li>
            </ul>
          </div>

          <!-- IISER Berhampur Wavefront Optics -->
          <div class="cv-entry hairline-box spotlight-card">
            <div class="cv-entry-head">
              <div>
                <h3 class="cv-role">Summer Research Intern (Wavefront Sensing &amp; Optics)</h3>
                <p class="cv-inst">Department of Physical Sciences, IISER Berhampur · Advisor: <strong>Dr. Vyas Akondi</strong></p>
              </div>
              <span class="cv-period mono text-secondary">MAY 2025 – JUL 2025</span>
            </div>
            <ul class="cv-bullets text-secondary">
              <li>Modeled exit-pupil optical wavefront aberrations using orthogonal circular Zernike polynomials.</li>
              <li>Built MATLAB simulations to quantify modal cross-coupling when scaling pupil apertures between ophthalmic and microscopic setups.</li>
            </ul>
          </div>

          <!-- Reading Project: Special Relativity -->
          <div class="cv-entry hairline-box spotlight-card">
            <div class="cv-entry-head">
              <div>
                <h3 class="cv-role">Mentored Reading Project (Special Theory of Relativity)</h3>
                <p class="cv-inst">Department of Physical Sciences, IISER Berhampur · Faculty Mentor: <strong>Dr. Sandeep Chatterjee</strong></p>
              </div>
              <span class="cv-period mono text-secondary">MAY 2025 – JUL 2025</span>
            </div>
            <ul class="cv-bullets text-secondary">
              <li>Systematically derived relativistic mechanics and Lorentz transformations in flat Minkowski spacetime.</li>
              <li>Formulated four-velocity, four-momentum conservation laws, and invariant intervals in tensorial notation.</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- 4. COMPUTATIONAL PROJECTS -->
      <section class="cv-section reveal-up" style="--stagger-index: 5;">
        <h2 class="cv-section-title mono text-gold">04 // SELECTED COMPUTATIONAL PROJECTS</h2>
        <div class="cv-entries-list">
          <div class="cv-entry hairline-box spotlight-card">
            <div class="cv-entry-head">
              <h3 class="cv-role">Physics-Informed CT Imaging &amp; ML Inverse Reconstruction</h3>
              <span class="cv-period mono text-secondary">FEB 2026 – AUG 2026</span>
            </div>
            <p class="cv-notes text-secondary">
              Engineered forward Radon projection and Filtered Back-Projection (FBP) reconstruction of Shepp-Logan phantoms. Classified normal tissue vs. hyper-attenuating tumours in Hounsfield Units via logistic regression models.
            </p>
          </div>

          <div class="cv-entry hairline-box spotlight-card">
            <div class="cv-entry-head">
              <h3 class="cv-role">Stochastic Simulation of Radioactive Decay via Monte Carlo</h3>
              <span class="cv-period mono text-secondary">JUN 2025 – JUL 2025</span>
            </div>
            <p class="cv-notes text-secondary">
              Formulated radioactive decay as a discrete stochastic Markov chain across initial populations N₀ ∈ [10, 10⁴]. Demonstrated breakdown of deterministic continuous kinetics at small numbers and verified σ_RMS ∝ 1/√N₀.
            </p>
          </div>

          <div class="cv-entry hairline-box spotlight-card">
            <div class="cv-entry-head">
              <h3 class="cv-role">ASTRA: High-Performance Rust Astrodynamics Toolkit</h3>
              <span class="cv-period mono text-secondary">AUTUMN 2025 – PRESENT</span>
            </div>
            <p class="cv-notes text-secondary">
              Implemented memory-safe orbital mechanics propagation using 4th/6th-order Yoshida symplectic integrators preserving Hamiltonian energy to ΔE/E₀ &lt; 10⁻¹² over 10⁶ epochs on conservative systems, alongside adaptive 8th-order Dormand-Prince (DOP853) and SGP4 perturbation models.
            </p>
          </div>
        </div>
      </section>

      <!-- 5. TECHNICAL SKILLS & MOOCS -->
      <section class="cv-section reveal-up" style="--stagger-index: 6;">
        <h2 class="cv-section-title mono text-gold">05 // TECHNICAL COMPETENCIES &amp; CERTIFICATIONS</h2>
        <div class="cv-skills-grid swiss-grid-12">
          <div class="col-6 skill-block hairline-box spotlight-card">
            <span class="meta-index">PROGRAMMING &amp; COMPUTING</span>
            <p class="skill-line mono"><strong>Languages:</strong> Python, Rust, C/C++, MATLAB, Bash</p>
            <p class="skill-line mono"><strong>Scientific Stack:</strong> Astropy, photutils, NumPy, SciPy, Matplotlib, Pandas, scikit-learn, IRAF/DAOPHOT, DS9</p>
            <p class="skill-line mono"><strong>Typesetting:</strong> LaTeX (pdfLaTeX, XeLaTeX, TikZ, PGFPlots)</p>
          </div>

          <div class="col-6 skill-block hairline-box spotlight-card">
            <span class="meta-index">COURSEWORK &amp; ONLINE CERTIFICATIONS</span>
            <p class="skill-line text-secondary"><strong>Stanford University (Coursera):</strong> Machine Learning Specialization</p>
            <p class="skill-line text-secondary"><strong>University of Michigan:</strong> Python for Everybody Specialization</p>
            <p class="skill-line text-secondary"><strong>UC Santa Cruz:</strong> C++ Programming &amp; Algorithmic Data Structures</p>
            <p class="skill-line text-secondary"><strong>Caltech Sagan Workshop:</strong> 2025 Sagan Summer Workshop on Exoplanet Science</p>
          </div>
        </div>
      </section>

      <!-- 6. POSITIONS OF RESPONSIBILITY -->
      <section class="cv-section reveal-up" style="--stagger-index: 7;">
        <h2 class="cv-section-title mono text-gold">06 // POSITIONS OF RESPONSIBILITY</h2>
        <div class="cv-entries-list">
          <div class="cv-entry hairline-box spotlight-card">
            <div class="cv-entry-head">
              <div>
                <h3 class="cv-role">Club Coordinator: Pixophiles (Photography &amp; Media Club)</h3>
                <p class="cv-inst">IISER Berhampur</p>
              </div>
              <span class="cv-period mono text-secondary">JAN 2025 – 2026</span>
            </div>
            <p class="cv-notes text-secondary">
              Executive head of official campus visual documentation. Curated 4 institutional photography exhibitions and directed technical workshops on camera exposure physics.
            </p>
          </div>

          <div class="cv-entry hairline-box spotlight-card">
            <div class="cv-entry-head">
              <div>
                <h3 class="cv-role">Core Member: Naxatra (Astronomy Club)</h3>
                <p class="cv-inst">IISER Berhampur</p>
              </div>
              <span class="cv-period mono text-secondary">APR 2025 – PRESENT</span>
            </div>
            <p class="cv-notes text-secondary">
              Coordinated nocturnal astronomical telescope observations, public transit viewings, and astrophotography sessions.
            </p>
          </div>

          <div class="cv-entry hairline-box spotlight-card">
            <div class="cv-entry-head">
              <div>
                <h3 class="cv-role">Campus Coordinator: Mimansa 2026</h3>
                <p class="cv-inst">IISER Pune Inter-College National Science Competition</p>
              </div>
              <span class="cv-period mono text-secondary">2026</span>
            </div>
            <p class="cv-notes text-secondary">
              Administered registration, logistical coordination, and examination invigilation at IISER Berhampur.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .cv-header {
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .cv-header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .cv-meta-strip {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .cv-download-btn {
    box-shadow: 0 4px 14px rgba(56, 189, 248, 0.25);
  }

  .cv-identity-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: var(--space-6);
  }

  .cv-identity-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: var(--space-2);
  }

  .cv-inst-emblem {
    border-radius: 6px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .cv-name {
    font-size: clamp(2rem, 3.5vw, 3rem);
    line-height: 1.15;
    margin: 0;
  }

  .cv-subline {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .cv-contact-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-top: 4px;
  }

  .cv-contact-strip a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .cv-contact-strip a:hover {
    color: var(--accent-primary);
    text-decoration: underline;
  }

  .cv-content-flow {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    padding-bottom: var(--space-14);
  }

  .cv-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cv-section-title {
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    margin: 0;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cv-entries-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .cv-entry {
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cv-entry-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cv-institution,
  .cv-role {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0;
  }

  .cv-degree,
  .cv-inst {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .cv-date-col {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    font-size: 0.75rem;
  }

  .cv-period {
    color: var(--text-tertiary);
  }

  .cv-grade {
    font-weight: 600;
  }

  .cv-notes {
    font-size: 0.8125rem;
    line-height: 1.6;
    margin: 0;
  }

  .cv-bullets {
    padding-left: 18px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  /* Awards Table */
  .cv-awards-table {
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .award-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 14px;
    align-items: baseline;
    font-size: 0.75rem;
    border-bottom: 1px dashed var(--border-subtle);
    padding-bottom: 8px;
  }

  .award-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .award-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Skills Grid */
  .skill-block {
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .skill-line {
    font-size: 0.78125rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .award-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .cv-date-col {
      align-items: flex-start;
    }
  }
</style>
