---
import BaseLayout from '../layouts/BaseLayout.astro';

const rabbitHoles = [
  {
    topic: 'GEOPOLITICS & MARITIME CORRIDORS',
    tag: 'GLOBAL TRADE & DEFENSE',
    title: 'Strategic Chokepoints & Semiconductor Supply Chains',
    desc: 'Analyzing naval chokepoints (Malacca, Hormuz, Bab-el-Mandeb), rare-earth mineral processing bottlenecks, and sovereign lithography fabrication facilities shaping 21st-century technological autonomy.'
  },
  {
    topic: 'TECH POLICY & DATA SOVEREIGNTY',
    tag: 'OPEN RESEARCH & GOVERNANCE',
    title: 'Open-Source Scientific Infrastructure & Algorithmic Sovereignty',
    desc: 'Investigating institutional dependencies on proprietary compute stacks, open-source scientific software preservation, and legal frameworks governing research data sovereignty in computational sciences.'
  },
  {
    topic: 'VISUAL ART',
    tag: 'GRAPHITE & PENCIL',
    title: 'Pencil Art & Sketching',
    desc: 'Observational pencil sketching and freehand graphite drawing. Exploring tonal gradients, form construction, and architectural perspective studies to sharpen visual intuition and spatial proportions off-screen.'
  },
  {
    topic: 'ANALYTICAL SKETCHING & FIELD NOTES',
    tag: 'VISUAL INQUIRY',
    title: 'Orthogonal Perspective & Optical Ray Diagrams',
    desc: 'Maintaining hand-drawn field notebooks with pen-and-ink diagrams of telescope optical trains, astronomical coordinates, brutalist campus architecture, and geometric wavefront traces.'
  }
];

// Static Curricular Progression: 5th of 10 semesters (50%)
const degreeProgressPercent = 50;

const toolkits = [
  {
    category: 'Scientific Systems & Languages',
    tools: [
      { name: 'Python', desc: 'Astropy, photutils, NumPy, SciPy, Matplotlib, Pandas, scikit-learn' },
      { name: 'Rust', desc: 'High-performance numerical simulation, memory-safe astrodynamics, concurrency' },
      { name: 'C / C++', desc: 'Pointer-level memory architectures, algorithm optimization, systems code' },
      { name: 'MATLAB', desc: 'Zernike wavefront modal decomposition, matrix eigensystems, 2D phase maps' },
      { name: 'POSIX Shell', desc: 'Workstation scripting, automated batch FITS processing, UNIX workflows' }
    ]
  },
  {
    category: 'Astronomical & Optical Software',
    tools: [
      { name: 'IRAF / DAOPHOT II', desc: 'Crowded-field stellar PSF modeling, aperture correction, CCD calibration' },
      { name: 'SAOImage DS9', desc: 'FITS visual analysis, coordinate astrometry, aperture extraction' },
      { name: 'Lightkurve / MAST', desc: 'TESS and Kepler time-series transit light-curve detrending' },
      { name: 'PARSEC Isochrones', desc: 'Stellar evolution CMD matching, age and distance modulus estimation' }
    ]
  },
  {
    category: 'Typesetting & Scientific Publishing',
    tools: [
      { name: 'LaTeX / TeX', desc: 'pdfLaTeX, XeLaTeX, LuaLaTeX, TikZ vector geometry, PGFPlots' },
      { name: 'Web & Visualisation', desc: 'Astro 5, TypeScript, HTML5 Canvas for real-time mathematical visualizations' },
      { name: 'Color & Media', desc: 'Digital RAW color grading, optical sensor noise evaluation' }
    ]
  }
];
---

<BaseLayout
  title="Academic Biography, Media & Inquiry | Soumitra Pharikal"
  description="Personal narrative, academic trajectory from Ahmedabad and Gandhinagar to IISER Berhampur, Fellowship Varta conversation, intellectual rabbit holes, and scientific toolkit."
>
  <div class="monograph-container">
    <header class="page-header reveal-up" style="--stagger-index: 1;">
      <div class="page-meta-strip">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span class="meta-index">§ 05 // ACADEMIC BIOGRAPHY &amp; INQUIRY</span>
        <span class="mono text-tertiary" style="font-size: 0.75rem; margin-left: 8px;">ORCID: <a href="https://orcid.org/0009-0001-8670-0352" target="_blank" rel="noopener noreferrer" class="editorial-link">0009-0001-8670-0352 ↗</a></span>
      </div>
      <h1 class="page-title">Biography, Trajectory &amp; Scientific Philosophy</h1>
      <p class="page-subtitle reading-measure text-secondary">
        Undergraduate student in Physics and Computational Sciences at IISER Berhampur. Bridging mathematical derivations with telescope reductions, recorded scientific dialogues, and reproducible research.
      </p>
    </header>

    <!-- ====================================================================
         SECTION 01: TWO-COLUMN NARRATIVE & EDUCATION JOURNEY GRID
         ==================================================================== -->
    <section class="about-grid-section">
      <div class="swiss-grid-12">
        <!-- Left: Prose Narrative -->
        <div class="col-7 narrative-column reveal-up" style="--stagger-index: 2;">
          <div class="prose-block">
            <h2 class="narrative-heading">Roots in Gujarat &amp; The Path to Fundamental Physics</h2>
            <p class="narrative-p text-secondary">
              I am a Bengali who grew up in Ahmedabad, Gujarat. My curiosity for quantitative science took shape during my schooling at <strong>Delhi Public School (DPS), Bopal, Ahmedabad</strong> and senior secondary education at <strong>Puna International School, Gandhinagar</strong>.
            </p>
            <p class="narrative-p text-secondary">
              Driven by a desire to understand celestial mechanics and physical laws from first principles, I qualified for the <strong>Pre-Regional Mathematical Olympiad (PRMO, Top 300)</strong> and the <strong>Indian National Astronomy Olympiad (INAO 2022, Top 256 Nationwide)</strong>. These competitions solidified my desire to pursue fundamental science, leading me to join the five-year integrated <strong>BS-MS Dual Degree</strong> at the <strong>Indian Institute of Science Education and Research (IISER) Berhampur</strong>, an autonomous Institute of National Importance under the Ministry of Education, Government of India.
            </p>

            <h2 class="narrative-heading">Dual Disciplinary Foundation</h2>
            <p class="narrative-p text-secondary">
              At IISER Berhampur, my undergraduate curriculum integrates a <strong>Physics Major</strong> with a <strong>Computational and Data Sciences Minor</strong> (Current CPI: <strong>8.15&nbsp;/&nbsp;10.0</strong>). In 2026, I secured <strong>Rank 1 on the Institute-Wide Merit List</strong> in the <strong>National Graduate Physics Examination (NGPE 2026)</strong> conducted by the Indian Association of Physics Teachers (IAPT).
            </p>
            <p class="narrative-p text-secondary">
              I treat computation as an empirical physics laboratory. Whether running PSF photometry on hundreds of crowded-field telescope CCD frames, simulating ill-posed tomographic inverse problems with filtered back-projection, or decomposing distorted wavefronts into orthogonal Zernike polynomials, my objective is always the same: testing how mathematical models hold up against noisy real-world data.
            </p>

            <h2 class="narrative-heading">Observational Operations &amp; Telescopic Outreach</h2>
            <p class="narrative-p text-secondary">
              Beyond individual research, I am deeply invested in our student scientific community. As a core member of <strong>Naxatra</strong> (the Astronomy Club of IISER Berhampur), I coordinate nocturnal telescope observation sessions with 8-inch Dobsonian reflectors and public sky-watching outreach across Southern Odisha dark-sky corridors.
            </p>
