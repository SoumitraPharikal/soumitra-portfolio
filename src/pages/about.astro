<script>
  function updateDegreeProgress() {
    const progressPercent = 45;
    const label = document.getElementById('degree-percent-label');
    const fill = document.getElementById('degree-progress-fill');
    const track = fill?.parentElement;
    const progressBlock = document.querySelector('.progress-block');

    if (label) label.textContent = 'Semester 5 of 10 · 45% Completed';
    if (track) track.setAttribute('aria-valuenow', '45');

    // Scroll-into-view fill animation
    if (fill && progressBlock && 'IntersectionObserver' in window) {
      fill.style.width = '0%';
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            fill.style.width = `${progressPercent}%`;
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2 });
      obs.observe(progressBlock);
    } else if (fill) {
      fill.style.width = `${progressPercent}%`;
    }
  }

  updateDegreeProgress();
  document.addEventListener('astro:page-load', updateDegreeProgress);
</script>

