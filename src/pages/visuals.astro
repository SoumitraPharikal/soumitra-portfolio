---
import BaseLayout from '../layouts/BaseLayout.astro';

const exhibitions = [
  {
    id: 'project-pandora',
    title: 'Project Pandora: Thematic Architectural Noir',
    category: 'Architectural & Geometry',
    year: '2025 – 2026',
    format: 'Curated Print Exhibition · IISER Berhampur',
    desc: 'Fine-art monochromatic investigation of concrete cantilever light shafts, geometric stairwells, and solitary student silhouettes across the brutalist academic architecture of IISER Berhampur.',
    specs: {
      camera: 'Sony Alpha 7 IV',
      lens: 'FE 24-70mm f/2.8 GM',
      iso: '100',
      exposure: '1/500s',
      aperture: 'f/8.0',
      location: 'IISERB Academic Complex'
    },
    accentColor: '#38BDF8'
  },
  {
    id: 'the-selling-shot',
    title: 'The Selling Shot: Precision Studio Specular Lighting',
    category: 'Exhibition Curation',
    year: '2025',
    format: 'Commercial Lighting Competition · Pixophiles',
    desc: 'Studio lighting masterclass and pan-campus creative competition evaluating 3-point key/fill/rim separation, macro focus stacking, specular highlight dissipation, and commercial glass refraction.',
    specs: {
      camera: 'Canon EOS 5D Mark IV',
      lens: '100mm f/2.8L Macro IS USM',
      iso: '50',
      exposure: '1/160s',
      aperture: 'f/11',
      location: 'Pixophiles Dark Studio'
    },
    accentColor: '#D4AF37'
  },
  {
    id: 'moments-in-motion',
    title: 'Moments in Motion 2.0: High-Speed Kinetic Freezing',
    category: 'Exhibition Curation',
    year: '2025',
    format: 'Action Photojournalism Summit · Pixophiles',
    desc: 'Kinetic capture competition focused on fast shutter synchronization, pan-tracking moving athletic subjects, and freezing transient mechanical fluid droplets at sub-millisecond shutter speeds (250 µs).',
    specs: {
      camera: 'Canon EOS R6',
      lens: 'EF 70-200mm f/2.8L IS III',
      iso: '3200',
      exposure: '1/4000s',
      aperture: 'f/2.8',
      location: 'Main Sports Complex'
    },
    accentColor: '#F97316'
  },
  {
    id: 'postcards-from-afar',
    title: 'Postcards from Afar: Southern Odisha Geomorphology',
    category: 'Landscape & Travel',
    year: '2025',
    format: 'Coastal Visual Ethnography Archive',
    desc: 'Field documentation of coastal geomorphology along the Bay of Bengal, maritime fishing fleet launches at Gopalpur-on-Sea, saline sand dune erosion, and estuarine light at dawn.',
    specs: {
      camera: 'Sony Alpha 7 IV',
      lens: 'FE 35mm f/1.4 GM',
      iso: '200',
      exposure: '1/800s',
      aperture: 'f/5.6',
      location: 'Gopalpur-on-Sea [19.261° N, 84.908° E]'
    },
    accentColor: '#10B981'
  },
  {
    id: 'deep-sky-astrophotography',
    title: 'Deep-Sky Astrophotography: Galactic Core & Nocturnal Star Trails',
    category: 'Astrophotography',
    year: '2024 – 2026',
    format: 'Naxatra Telescopic Imaging Expeditions',
    desc: 'Equatorial tracking and multi-frame stacking of the Sagittarius and Cygnus arm starfields (via Sky-Watcher Adventurer mount), high-magnification lunar crater astrometry via 8-inch manual Dobsonian reflector, and nocturnal 3-hour circumpolar star trail reductions.',
    specs: {
      camera: 'Canon EOS 80D (Astro-Modified)',
      lens: '8" Dobsonian f/6 & 18-55mm IS STM',
      iso: '6400',
      exposure: '45x60s (Stacking)',
      aperture: 'f/3.5 – f/6.0',
      location: 'Southern Odisha Dark-Sky Plateau'
    },
    accentColor: '#00F0FF'
  },
  {
    id: 'optomechanical-diffraction',
    title: 'Optomechanical Diffraction: Coherent Laser Interference',
    category: 'Optomechanical Physics',
    year: '2025',
    format: 'Wave Optics Laboratory Archive',
    desc: 'Monochromatic imaging of He-Ne 632.8 nm laser diffraction patterns, circular aperture Airy disc intensity rings, and Michelson interferometric fringe phase shifts used to evaluate optical wavefront distortion.',
    specs: {
      camera: 'CMOS Monochrome Scientific Sensor',
      lens: 'Microscope Objective 10x 0.25 NA',
      iso: 'N/A (Raw Photon Counts)',
      exposure: '1/2000s',
      aperture: '150 µm Pinhole',
      location: 'Optics Laboratory, Dept of Physical Sciences'
    },
    accentColor: '#A855F7'
  }
];

const categories = [
  'All',
  'Astrophotography',
  'Architectural & Geometry',
  'Exhibition Curation',
  'Landscape & Travel',
  'Optomechanical Physics'
];
---

<BaseLayout
  title="Visual Arts & Astrophotography Archive | Soumitra Pharikal"
  description="Astrophotography, observational sky frames, and architectural photography by Soumitra Pharikal."
>
  <div class="monograph-container">
    <header class="page-header reveal-up" style="--stagger-index: 1;">
      <div class="page-meta-strip">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span class="meta-index">§ 07 // VISUAL ARTS &amp; ASTROPHOTOGRAPHY ARCHIVE</span>
      </div>
      <h1 class="page-title">Curated Exhibitions, Optical Studies &amp; Astrophotography</h1>
      <p class="page-subtitle reading-measure text-secondary">
        Monochromatic architectural studies, studio specular lighting, high-speed kinetic captures, deep-sky telescope reductions, and wave optics diffraction patterns from the Pixophiles and Naxatra archives.
      </p>

      <!-- Category Filter Pills -->
      <div class="filter-pills-bar mono">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class:list={['filter-pill', { 'is-active': idx === 0 }]}
            data-filter={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </header>

    <!-- 6 Flagship Exhibition Cards Grid -->
    <section class="gallery-section">
      <div class="swiss-grid-12 gallery-grid">
        {exhibitions.map((exhibit, idx) => (
          <article
            class="col-6 exhibit-card hairline-box spotlight-card corner-crosshair reveal-up"
            data-category={exhibit.category}
            style={`--stagger-index: ${idx + 2};`}
          >
            <!-- Visual Exhibit Canvas / Plate -->
            <div class="exhibit-frame" style={`--accent-frame: ${exhibit.accentColor};`}>
              {exhibit.id === 'project-pandora' && (
                <svg viewBox="0 0 540 280" class="exhibit-svg" aria-label="Project Pandora Architectural Noir Geometry">
                  <defs>
                    <linearGradient id="pandoraGrad" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#0F172A" />
                      <stop offset="60%" stop-color="#020617" />
                      <stop offset="100%" stop-color="#000000" />
                    </linearGradient>
                    <linearGradient id="lightBeam" x1="0" y1="0" x2="0.8" y2="1">
                      <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.5" />
                      <stop offset="100%" stop-color="#38BDF8" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <rect width="540" height="280" fill="url(#pandoraGrad)" />
                  <!-- Brutalist Structural Lines -->
                  <polygon points="120,0 220,0 360,280 180,280" fill="url(#lightBeam)" />
                  <line x1="80" y1="0" x2="160" y2="280" stroke="#38BDF8" stroke-width="1.2" opacity="0.4" />
                  <line x1="260" y1="0" x2="420" y2="280" stroke="#38BDF8" stroke-width="1.5" opacity="0.6" />
                  <line x1="400" y1="0" x2="520" y2="280" stroke="#FFFFFF" stroke-width="0.8" opacity="0.3" />
                  <!-- Horizontal Floor Slats -->
                  <line x1="0" y1="210" x2="540" y2="210" stroke="rgba(255,255,255,0.15)" stroke-width="1" />
                  <line x1="0" y1="240" x2="540" y2="240" stroke="rgba(255,255,255,0.1)" stroke-width="1" stroke-dasharray="8 6" />
                  <!-- Solitary Figure Silhouette -->
                  <circle cx="280" cy="180" r="7" fill="#F3F1EC" />
                  <path d="M280 187 L276 210 L284 210 Z" fill="#F3F1EC" />
                  <!-- Coordinate Callout -->
                  <text x="24" y="32" font-family="JetBrains Mono" font-size="11" fill="#38BDF8" letter-spacing="1.5">EXHIBITION 01 // ARCHITECTURAL NOIR</text>
                  <text x="24" y="260" font-family="JetBrains Mono" font-size="12" fill="#94A3B8">CONTRAST: 1:1200 · ZONE SYSTEM VIII</text>
                </svg>
              )}

              {exhibit.id === 'the-selling-shot' && (
                <svg viewBox="0 0 540 280" class="exhibit-svg" aria-label="The Selling Shot Studio Specular Lighting">
                  <defs>
                    <radialGradient id="studioSpot" cx="50%" cy="40%" r="60%">
                      <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.4" />
                      <stop offset="45%" stop-color="#1E1B4B" stop-opacity="0.8" />
                      <stop offset="100%" stop-color="#030712" />
                    </radialGradient>
                  </defs>
                  <rect width="540" height="280" fill="url(#studioSpot)" />
                  <!-- Macro Perfume / Glass Prism Silhouette -->
                  <polygon points="230,70 310,70 330,220 210,220" fill="none" stroke="#D4AF37" stroke-width="2" />
                  <line x1="270" y1="50" x2="270" y2="70" stroke="#D4AF37" stroke-width="3" />
                  <!-- Specular Rim Reflections -->
                  <path d="M232,74 L213,216" stroke="#FFFFFF" stroke-width="2.5" opacity="0.9" />
                  <path d="M308,74 L327,216" stroke="#F59E0B" stroke-width="1.8" opacity="0.8" />
                  <!-- Refraction Caustic Waves -->
                  <ellipse cx="270" cy="220" rx="90" ry="16" fill="none" stroke="#D4AF37" stroke-width="1" stroke-dasharray="4 4" opacity="0.6" />
                  <text x="24" y="32" font-family="JetBrains Mono" font-size="11" fill="#D4AF37" letter-spacing="1.5">EXHIBITION 02 // SPECULAR RIM LIGHTING</text>
                  <text x="24" y="260" font-family="JetBrains Mono" font-size="12" fill="#94A3B8">3-POINT KEY/RIM POLARIZATION · CPL</text>
                </svg>
              )}

              {exhibit.id === 'moments-in-motion' && (
                <svg viewBox="0 0 540 280" class="exhibit-svg" aria-label="Moments in Motion Kinetic Freezing">
                  <defs>
                    <linearGradient id="motionGrad" x1="0" y1="0" x2="1" y2="0">
                      <stop offset="0%" stop-color="#431407" />
                      <stop offset="50%" stop-color="#18181B" />
                      <stop offset="100%" stop-color="#09090B" />
                    </linearGradient>
                  </defs>
                  <rect width="540" height="280" fill="url(#motionGrad)" />
                  <!-- Kinetic Motion Streaks -->
                  <path d="M20,140 Q180,60 340,140 T520,130" fill="none" stroke="#F97316" stroke-width="2.5" />
                  <path d="M20,160 Q200,80 360,160 T520,150" fill="none" stroke="#FB923C" stroke-width="1.5" stroke-dasharray="6 3" />
                  <path d="M40,110 Q220,40 380,120 T520,110" fill="none" stroke="#FBBF24" stroke-width="1" opacity="0.6" />
                  <!-- High Speed Stroboscopic Fluid Droplets -->
                  <circle cx="280" cy="95" r="4.5" fill="#FFFFFF" />
                  <circle cx="310" cy="80" r="3" fill="#F97316" />
                  <circle cx="330" cy="115" r="5" fill="#FBBF24" />
                  <circle cx="360" cy="90" r="2.5" fill="#FFFFFF" />
                  <circle cx="250" cy="110" r="3.5" fill="#F97316" />
                  <text x="24" y="32" font-family="JetBrains Mono" font-size="11" fill="#F97316" letter-spacing="1.5">EXHIBITION 03 // 1/4000S KINETIC FREEZE</text>
                  <text x="24" y="260" font-family="JetBrains Mono" font-size="12" fill="#94A3B8">STROBOSCOPIC SYNC · 12 FPS MECHANICAL</text>
                </svg>
              )}

              {exhibit.id === 'postcards-from-afar' && (
                <svg viewBox="0 0 540 280" class="exhibit-svg" aria-label="Postcards from Afar Coastal Landscape">
                  <defs>
                    <linearGradient id="oceanGrad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#022C22" />
                      <stop offset="40%" stop-color="#064E3B" />
                      <stop offset="70%" stop-color="#047857" />
                      <stop offset="100%" stop-color="#06120E" />
                    </linearGradient>
                  </defs>
                  <rect width="540" height="280" fill="url(#oceanGrad)" />
                  <!-- Bay of Bengal Tidal Waves -->
                  <path d="M0,160 C120,140 240,180 360,150 C440,130 490,160 540,150 L540,280 L0,280 Z" fill="#047857" opacity="0.4" />
                  <path d="M0,190 C150,170 300,210 420,180 C480,165 510,190 540,185 L540,280 L0,280 Z" fill="#064E3B" opacity="0.6" />
                  <path d="M0,230 C180,215 320,240 450,225 L540,230 L540,280 L0,280 Z" fill="#022C22" />
                  <!-- Traditional Odisha Fishing Trawler -->
                  <polygon points="360,135 390,135 385,145 355,145" fill="#F3F1EC" />
                  <line x1="375" y1="115" x2="375" y2="135" stroke="#F3F1EC" stroke-width="1.5" />
                  <polygon points="375,117 386,128 375,128" fill="#10B981" />
                  <text x="24" y="32" font-family="JetBrains Mono" font-size="11" fill="#10B981" letter-spacing="1.5">EXHIBITION 04 // GOPALPUR-ON-SEA TIDES</text>
                  <text x="24" y="260" font-family="JetBrains Mono" font-size="12" fill="#94A3B8">LAT: 19.261° N · LON: 84.908° E · ND8 GRADUATED</text>
                </svg>
              )}

              {exhibit.id === 'deep-sky-astrophotography' && (
                <svg viewBox="0 0 540 280" class="exhibit-svg" aria-label="Deep-Sky Astrophotography Starfield">
                  <defs>
                    <radialGradient id="milkywayGrad" cx="60%" cy="50%" r="55%">
                      <stop offset="0%" stop-color="#00F0FF" stop-opacity="0.35" />
                      <stop offset="35%" stop-color="#1E1B4B" stop-opacity="0.8" />
                      <stop offset="100%" stop-color="#020617" />
                    </radialGradient>
                  </defs>
                  <rect width="540" height="280" fill="url(#milkywayGrad)" />
                  <!-- Celestial Dust Lane -->
                  <path d="M120,280 Q240,160 380,80 T540,0" fill="none" stroke="#38BDF8" stroke-width="45" opacity="0.12" filter="blur(14px)" />
                  <path d="M100,280 Q220,150 360,70 T540,0" fill="none" stroke="#C084FC" stroke-width="30" opacity="0.15" filter="blur(10px)" />
                  <!-- Star Cluster Dots -->
                  <circle cx="340" cy="110" r="2.2" fill="#FFFFFF" />
                  <circle cx="355" cy="125" r="1.8" fill="#38BDF8" />
                  <circle cx="330" cy="130" r="1.5" fill="#FBBF24" />
                  <circle cx="370" cy="100" r="2.5" fill="#FFFFFF" />
                  <circle cx="320" cy="95" r="1.6" fill="#38BDF8" />
                  <circle cx="210" cy="180" r="2" fill="#FFFFFF" />
                  <circle cx="160" cy="220" r="1.7" fill="#FBBF24" />
                  <circle cx="440" cy="60" r="2.8" fill="#FFFFFF" />
                  <circle cx="480" cy="45" r="1.9" fill="#38BDF8" />
                  <!-- Circular Reticle Overlay -->
                  <circle cx="350" cy="110" r="28" fill="none" stroke="#00F0FF" stroke-width="1" stroke-dasharray="3 3" opacity="0.6" />
                  <text x="24" y="32" font-family="JetBrains Mono" font-size="11" fill="#00F0FF" letter-spacing="1.5">EXHIBITION 05 // DEEP-SKY SAGITTARIUS ARM</text>
                  <text x="24" y="260" font-family="JetBrains Mono" font-size="12" fill="#94A3B8">8" DOBSONIAN (LUNAR) · SKY-WATCHER ADVENTURER (DEEP SKY) · 45x60S</text>
                </svg>
              )}

              {exhibit.id === 'optomechanical-diffraction' && (
                <svg viewBox="0 0 540 280" class="exhibit-svg" aria-label="Optomechanical Laser Diffraction Pattern">
                  <defs>
                    <radialGradient id="laserGrad" cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="#EC4899" stop-opacity="0.9" />
                      <stop offset="15%" stop-color="#8B5CF6" stop-opacity="0.6" />
                      <stop offset="45%" stop-color="#1E1B4B" stop-opacity="0.4" />
                      <stop offset="100%" stop-color="#05050D" />
                    </radialGradient>
                  </defs>
                  <rect width="540" height="280" fill="url(#laserGrad)" />
                  <!-- Concentric Circular Airy Disks -->
                  <circle cx="270" cy="140" r="12" fill="#FFFFFF" opacity="0.95" />
                  <circle cx="270" cy="140" r="28" fill="none" stroke="#A855F7" stroke-width="2.5" opacity="0.85" />
                  <circle cx="270" cy="140" r="46" fill="none" stroke="#A855F7" stroke-width="1.8" opacity="0.6" />
                  <circle cx="270" cy="140" r="66" fill="none" stroke="#C084FC" stroke-width="1.4" opacity="0.45" />
                  <circle cx="270" cy="140" r="88" fill="none" stroke="#E879F9" stroke-width="1" opacity="0.3" />
                  <circle cx="270" cy="140" r="112" fill="none" stroke="#E879F9" stroke-width="0.8" opacity="0.2" stroke-dasharray="4 2" />
                  <!-- Crosshair Measurement Axes -->
                  <line x1="270" y1="10" x2="270" y2="270" stroke="#A855F7" stroke-width="0.8" stroke-dasharray="2 4" opacity="0.5" />
                  <line x1="80" y1="140" x2="460" y2="140" stroke="#A855F7" stroke-width="0.8" stroke-dasharray="2 4" opacity="0.5" />
                  <text x="24" y="32" font-family="JetBrains Mono" font-size="11" fill="#A855F7" letter-spacing="1.5">EXHIBITION 06 // AIRY DISK BESSEL PROFILE</text>
                  <text x="24" y="260" font-family="JetBrains Mono" font-size="12" fill="#94A3B8">λ = 632.8 NM · 150 µM PINHOLE · 2D BESSEL J₁(x)/x</text>
                </svg>
              )}

              <!-- Zoom Overlay Trigger Button -->
              <button
                type="button"
                class="zoom-trigger-btn mono"
                data-exhibit-id={exhibit.id}
                aria-label={`Open high-resolution view of ${exhibit.title}`}
              >
                Inspect Exhibit ⌕
              </button>
            </div>

            <!-- Exhibit Metadata & Description -->
            <div class="exhibit-body">
              <div class="exhibit-header-row">
                <span class="mono exhibit-category" style={`color: ${exhibit.accentColor};`}>{exhibit.category}</span>
                <span class="mono exhibit-period text-tertiary">{exhibit.year}</span>
              </div>

              <h2 class="exhibit-title">{exhibit.title}</h2>
              <span class="exhibit-format mono text-secondary">{exhibit.format}</span>
              <p class="exhibit-desc text-secondary">{exhibit.desc}</p>

              <!-- Technical Monospace EXIF Metadata Plate -->
              <div class="exif-plate hairline-top mono">
                <div class="exif-row">
                  <span class="exif-label text-tertiary">OPTICAL SETUP:</span>
                  <span class="exif-val text-primary">{exhibit.specs.camera} · {exhibit.specs.lens}</span>
                </div>
                <div class="exif-grid-3">
                  <div>
                    <span class="exif-label text-tertiary">ISO:</span>
                    <span class="exif-val">{exhibit.specs.iso}</span>
                  </div>
                  <div>
                    <span class="exif-label text-tertiary">EXPOSURE:</span>
                    <span class="exif-val">{exhibit.specs.exposure}</span>
                  </div>
                  <div>
                    <span class="exif-label text-tertiary">APERTURE:</span>
                    <span class="exif-val">{exhibit.specs.aperture}</span>
                  </div>
                </div>
                <div class="exif-row">
                  <span class="exif-label text-tertiary">LOCATION:</span>
                  <span class="exif-val text-accent">{exhibit.specs.location}</span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Modal Zoom Lightbox Dialog -->
    <dialog id="exhibit-modal" class="exhibit-modal-dialog">
      <div class="modal-box hairline-box spotlight-card">
        <div class="modal-header">
          <span class="mono modal-eyebrow text-gold">EXHIBIT INSPECTION MODAL</span>
          <button type="button" id="modal-close-btn" class="modal-close-btn mono" aria-label="Close Modal">✕ CLOSE (ESC)</button>
        </div>
        <div id="modal-viewport" class="modal-viewport">
          <!-- Dynamically populated SVG clone -->
        </div>
        <div id="modal-caption" class="modal-caption mono text-secondary">
          <!-- Caption text -->
        </div>
      </div>
    </dialog>
  </div>
</BaseLayout>

<script>
  function initVisualsGallery() {
    // 1. Category Filtering
    const filterPills = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.exhibit-card');

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => p.classList.remove('is-active'));
        pill.classList.add('is-active');

        const filter = pill.getAttribute('data-filter') || 'All';
        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'All' || category === filter) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // 2. Modal Zoom Lightbox with Keyboard Arrow & Escape Navigation
    const modal = document.getElementById('exhibit-modal') as HTMLDialogElement | null;
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalViewport = document.getElementById('modal-viewport');
    const modalCaption = document.getElementById('modal-caption');
    const zoomBtns = document.querySelectorAll('.zoom-trigger-btn');
    const exhibitCards = Array.from(document.querySelectorAll('.exhibit-card'));
    let currentExhibitIndex = 0;

    function openModalForCard(card: Element) {
      if (!modal || !modalViewport || !modalCaption) return;
      currentExhibitIndex = exhibitCards.indexOf(card as HTMLElement);
      const svg = card.querySelector('.exhibit-svg');
      const title = card.querySelector('.exhibit-title')?.textContent || '';
      const format = card.querySelector('.exhibit-format')?.textContent || '';

      if (svg) {
        modalViewport.innerHTML = svg.outerHTML;
      }
      modalCaption.textContent = `${title} · ${format} [${currentExhibitIndex + 1} / ${exhibitCards.length}] (← / → to navigate)`;
      if (!modal.open) modal.showModal();
    }

    zoomBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.exhibit-card');
        if (card) openModalForCard(card);
      });
    });

    modalCloseBtn?.addEventListener('click', () => {
      modal?.close();
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.close();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (!modal?.open) return;
      if (e.key === 'Escape') {
        modal.close();
      } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        currentExhibitIndex = (currentExhibitIndex + 1) % exhibitCards.length;
        openModalForCard(exhibitCards[currentExhibitIndex]);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        currentExhibitIndex = (currentExhibitIndex - 1 + exhibitCards.length) % exhibitCards.length;
        openModalForCard(exhibitCards[currentExhibitIndex]);
      }
    });
  }

  initVisualsGallery();
  document.addEventListener('astro:page-load', initVisualsGallery);
</script>

<style>
  .page-header {
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .page-meta-strip {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .page-title {
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    font-weight: 500;
    margin: 0 0 var(--space-3) 0;
  }

  .page-subtitle {
    font-size: var(--text-lead);
    line-height: var(--leading-body);
    margin: 0 0 var(--space-6) 0;
  }

  /* Filter Pills */
  .filter-pills-bar {
